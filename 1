"""
Méthode de sélection du meilleur dataframe d'entraînement (A ou B)
en comparant leurs variables explicatives à celles de X (jeu cible).

Deux diagnostics complémentaires :
1. Validation adversariale (score global de "distinguabilité")
2. PSI par variable (score détaillé, localise les variables qui dérivent)

Nécessite : pandas, numpy, lightgbm, scikit-learn
"""

import numpy as np
import pandas as pd
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import roc_auc_score
import lightgbm as lgb


def variables_communes(df_x: pd.DataFrame, df_candidat: pd.DataFrame) -> list:
    """Retourne les colonnes explicatives présentes dans les deux dataframes."""
    return sorted(set(df_x.columns) & set(df_candidat.columns))


def score_adversarial(df_x: pd.DataFrame, df_candidat: pd.DataFrame,
                       variables: list, n_splits: int = 5, random_state: int = 42) -> float:
    """
    Entraîne un classifieur à distinguer df_candidat (label 0) de df_x (label 1)
    en utilisant uniquement les variables communes.
    Retourne l'AUC moyenne en validation croisée.
    AUC proche de 0.5 => distributions similaires => bon candidat.
    AUC proche de 1.0 => distributions très différentes => mauvais candidat.
    """
    X_c = df_candidat[variables].copy()
    X_x = df_x[variables].copy()

    # Encodage simple des catégorielles (à adapter selon tes données)
    combined = pd.concat([X_c, X_x], axis=0, ignore_index=True)
    for col in combined.select_dtypes(include=["object", "category"]).columns:
        combined[col] = combined[col].astype("category").cat.codes

    y = np.array([0] * len(X_c) + [1] * len(X_x))

    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=random_state)
    aucs = []
    for train_idx, test_idx in skf.split(combined, y):
        model = lgb.LGBMClassifier(
            n_estimators=200, max_depth=4, learning_rate=0.05,
            verbosity=-1, random_state=random_state
        )
        model.fit(combined.iloc[train_idx], y[train_idx])
        preds = model.predict_proba(combined.iloc[test_idx])[:, 1]
        aucs.append(roc_auc_score(y[test_idx], preds))

    return float(np.mean(aucs))


def psi(expected: pd.Series, actual: pd.Series, bins: int = 10) -> float:
    """
    Calcule le Population Stability Index entre deux distributions
    d'une même variable (numérique). PSI < 0.1 : stable, 0.1-0.25 : dérive
    modérée, > 0.25 : dérive importante.
    """
    expected = expected.dropna()
    actual = actual.dropna()

    if pd.api.types.is_numeric_dtype(expected):
        quantiles = np.linspace(0, 1, bins + 1)
        breakpoints = np.unique(expected.quantile(quantiles).values)
        if len(breakpoints) < 3:
            return np.nan
        exp_counts = pd.cut(expected, breakpoints, include_lowest=True).value_counts(normalize=True)
        act_counts = pd.cut(actual, breakpoints, include_lowest=True).value_counts(normalize=True)
    else:
        exp_counts = expected.value_counts(normalize=True)
        act_counts = actual.value_counts(normalize=True)

    exp_counts, act_counts = exp_counts.align(act_counts, fill_value=1e-6)
    exp_counts = exp_counts.replace(0, 1e-6)
    act_counts = act_counts.replace(0, 1e-6)

    return float(np.sum((act_counts - exp_counts) * np.log(act_counts / exp_counts)))


def psi_par_variable(df_x: pd.DataFrame, df_candidat: pd.DataFrame, variables: list) -> pd.DataFrame:
    """Calcule le PSI de chaque variable commune entre le candidat et X."""
    resultats = []
    for var in variables:
        try:
            val = psi(df_candidat[var], df_x[var])
        except Exception:
            val = np.nan
        resultats.append({"variable": var, "psi": val})
    return pd.DataFrame(resultats).sort_values("psi", ascending=False)


def evaluer_candidat(nom: str, df_x: pd.DataFrame, df_candidat: pd.DataFrame) -> dict:
    """Évalue un candidat sur les deux diagnostics et retourne un résumé."""
    variables = variables_communes(df_x, df_candidat)
    auc = score_adversarial(df_x, df_candidat, variables)
    psi_df = psi_par_variable(df_x, df_candidat, variables)

    return {
        "nom": nom,
        "n_variables_communes": len(variables),
        "auc_adversarial": auc,
        "score_similarite": 1 - abs(auc - 0.5) * 2,  # 1 = identique, 0 = totalement séparable
        "psi_moyen": psi_df["psi"].mean(),
        "top5_variables_derivantes": psi_df.head(5).to_dict("records"),
    }


