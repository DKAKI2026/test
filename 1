"""
Méthode alternative : comparaison des dataframes via Maximum Mean Discrepancy (MMD)

Contrairement à la validation adversariale (classifieur) ou au PSI (univarié),
le MMD mesure directement l'écart entre deux distributions multivariées dans un
espace de noyau (RBF), sans entraîner de modèle. Il capture les interactions
entre variables, pas seulement les marginales.

Nécessite : numpy, pandas, scikit-learn, scipy
"""

import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.metrics.pairwise import rbf_kernel


def preparer_donnees(df_x: pd.DataFrame, df_candidat: pd.DataFrame, variables: list):
    """
    Restreint aux variables communes, encode les catégorielles,
    standardise (indispensable pour un noyau RBF), et retourne deux
    matrices numpy comparables.
    """
    X_c = df_candidat[variables].copy()
    X_x = df_x[variables].copy()

    combined = pd.concat([X_c, X_x], axis=0, ignore_index=True)
    for col in combined.select_dtypes(include=["object", "category"]).columns:
        combined[col] = combined[col].astype("category").cat.codes

    combined = combined.fillna(combined.median(numeric_only=True))

    scaler = StandardScaler()
    combined_scaled = scaler.fit_transform(combined)

    n_c = len(X_c)
    return combined_scaled[:n_c], combined_scaled[n_c:]


"""
Méthode alternative : comparaison des dataframes via Maximum Mean Discrepancy (MMD)

Contrairement à la validation adversariale (classifieur) ou au PSI (univarié),
le MMD mesure directement l'écart entre deux distributions multivariées dans un
espace de noyau (RBF), sans entraîner de modèle. Il capture les interactions
entre variables, pas seulement les marginales.

Nécessite : numpy, pandas, scikit-learn, scipy
"""

import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.metrics.pairwise import rbf_kernel


def preparer_donnees(df_x: pd.DataFrame, df_candidat: pd.DataFrame, variables: list,
                      n_max: int = 3000, random_state: int = 42):
    """
    Restreint aux variables communes, encode les catégorielles,
    standardise (indispensable pour un noyau RBF), et retourne deux
    matrices numpy comparables.

    n_max : le calcul du MMD est en O(n^2) en mémoire (matrice n x n).
    Au-delà de quelques milliers de lignes, la matrice devient trop
    grosse (ex: 50 000 lignes -> matrice de 20 Go). On sous-échantillonne
    donc chaque dataframe à n_max lignes max ; un échantillon aléatoire
    suffit largement pour estimer une distance entre distributions.
    """
    df_candidat = (df_candidat.sample(n=n_max, random_state=random_state)
                   if len(df_candidat) > n_max else df_candidat)
    df_x = (df_x.sample(n=n_max, random_state=random_state)
            if len(df_x) > n_max else df_x)

    X_c = df_candidat[variables].copy()
    X_x = df_x[variables].copy()

    combined = pd.concat([X_c, X_x], axis=0, ignore_index=True)
    for col in combined.select_dtypes(include=["object", "category"]).columns:
        combined[col] = combined[col].astype("category").cat.codes

    combined = combined.fillna(combined.median(numeric_only=True))

    scaler = StandardScaler()
    combined_scaled = scaler.fit_transform(combined)

    n_c = len(X_c)
    return combined_scaled[:n_c], combined_scaled[n_c:]


def mmd_rbf(A: np.ndarray, B: np.ndarray, gamma: float = None) -> float:
    """
    Calcule le MMD^2 (estimateur non biaisé) entre deux échantillons A et B
    avec un noyau RBF. Plus la valeur est proche de 0, plus les distributions
    sont similaires.
    """
    if gamma is None:
        # heuristique standard : inverse de la dimensionnalité
        gamma = 1.0 / A.shape[1]

    K_AA = rbf_kernel(A, A, gamma=gamma)
    K_BB = rbf_kernel(B, B, gamma=gamma)
    K_AB = rbf_kernel(A, B, gamma=gamma)

    n, m = len(A), len(B)
    np.fill_diagonal(K_AA, 0)
    np.fill_diagonal(K_BB, 0)

    mmd2 = (K_AA.sum() / (n * (n - 1))
            + K_BB.sum() / (m * (m - 1))
            - 2 * K_AB.mean())
    return float(mmd2)


def test_permutation_mmd(A: np.ndarray, B: np.ndarray, n_permutations: int = 200,
                          gamma: float = None, random_state: int = 42) -> dict:
    """
    Teste si le MMD observé est significativement différent de 0
    (c.-à-d. si les deux distributions sont vraiment différentes)
    via un test de permutation.
    """
    rng = np.random.default_rng(random_state)
    observed = mmd_rbf(A, B, gamma=gamma)

    combined = np.vstack([A, B])
    n = len(A)
    null_dist = []
    for _ in range(n_permutations):
        perm = rng.permutation(len(combined))
        A_perm = combined[perm[:n]]
        B_perm = combined[perm[n:]]
        null_dist.append(mmd_rbf(A_perm, B_perm, gamma=gamma))

    null_dist = np.array(null_dist)
    p_value = float((null_dist >= observed).mean())

    return {"mmd": observed, "p_value": p_value, "null_dist_mean": null_dist.mean()}


def evaluer_candidat_mmd(nom: str, df_x: pd.DataFrame, df_candidat: pd.DataFrame,
                          n_permutations: int = 200, n_max: int = 3000) -> dict:
    """Évalue un candidat via MMD + test de permutation.

    n_max : taille max de l'échantillon utilisé pour le calcul (voir
    preparer_donnees) — à ajuster selon ta mémoire disponible. 3000-5000
    est un bon compromis précision/mémoire sur un poste standard.
    """
    variables = sorted(set(df_x.columns) & set(df_candidat.columns))
    A, B = preparer_donnees(df_x, df_candidat, variables, n_max=n_max)
    resultat = test_permutation_mmd(A, B, n_permutations=n_permutations)
    resultat["nom"] = nom
    resultat["n_variables_communes"] = len(variables)
    resultat["taille_echantillon"] = len(A)
    return resultat


