    """
Visualisation des résultats des scripts de sélection de dataframe :
- selection_dataframe_entrainement.py (AUC adversariale + PSI)
- selection_dataframe_mmd.py (MMD + test de permutation)

Nécessite : matplotlib, seaborn, umap-learn (pip install umap-learn)
"""

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme(style="whitegrid")


# ---------------------------------------------------------------------------
# 1. Comparaison globale entre candidats (AUC adversariale ou MMD)
# ---------------------------------------------------------------------------
def plot_comparaison_candidats(resultats: list[dict], metrique: str = "score_similarite"):
    """
    resultats : liste de dicts retournés par evaluer_candidat() ou
                evaluer_candidat_mmd(), un par candidat.
    metrique  : "score_similarite" (1=idéal) pour la méthode adversariale,
                ou "mmd" (0=idéal) pour la méthode MMD.
    """
    noms = [r["nom"] for r in resultats]
    valeurs = [r[metrique] for r in resultats]

    fig, ax = plt.subplots(figsize=(6, 4))
    couleurs = sns.color_palette("Greens_d", len(noms)) if metrique == "score_similarite" \
        else sns.color_palette("Reds_d", len(noms))
    bars = ax.bar(noms, valeurs, color=couleurs)
    ax.bar_label(bars, fmt="%.3f")
    ax.set_ylabel(metrique)
    ax.set_title(f"Comparaison des candidats — {metrique}")
    if metrique == "score_similarite":
        ax.set_ylim(0, 1)
        ax.axhline(0.5, color="gray", linestyle="--", linewidth=1, label="seuil neutre")
        ax.legend()
    plt.tight_layout()
    plt.show()


# ---------------------------------------------------------------------------
# 2. PSI par variable, avec seuils colorés
# ---------------------------------------------------------------------------
def plot_psi(psi_df: pd.DataFrame, top_n: int = 15, titre: str = "PSI par variable"):
    """
    psi_df : dataframe avec colonnes 'variable' et 'psi', retourné par
             psi_par_variable().
    Seuils standards : <0.1 stable, 0.1-0.25 dérive modérée, >0.25 dérive forte.
    """
    df = psi_df.dropna(subset=["psi"]).sort_values("psi", ascending=True).tail(top_n)

    def couleur(v):
        if v < 0.1:
            return "#4CAF50"   # stable
        elif v < 0.25:
            return "#FF9800"   # modéré
        return "#F44336"       # critique

    couleurs = df["psi"].apply(couleur)

    fig, ax = plt.subplots(figsize=(7, max(4, 0.35 * len(df))))
    ax.barh(df["variable"], df["psi"], color=couleurs)
    ax.axvline(0.1, color="gray", linestyle="--", linewidth=1)
    ax.axvline(0.25, color="gray", linestyle="--", linewidth=1)
    ax.set_xlabel("PSI")
    ax.set_title(titre)
    plt.tight_layout()
    plt.show()


# ---------------------------------------------------------------------------
# 3. Test de permutation MMD : distribution nulle vs valeur observée
# ---------------------------------------------------------------------------
def plot_test_permutation(observed: float, null_dist: np.ndarray, nom_candidat: str = ""):
    """
    observed  : le MMD observé (résultat['mmd'])
    null_dist : liste des MMD calculés sous permutation aléatoire —
                à récupérer en modifiant test_permutation_mmd() pour
                retourner null_dist en plus de p_value (voir note ci-dessous).
    """
    fig, ax = plt.subplots(figsize=(6, 4))
    ax.hist(null_dist, bins=30, color="#90A4AE", alpha=0.8, label="distribution nulle\n(si aucune différence réelle)")
    ax.axvline(observed, color="#F44336", linewidth=2, label=f"MMD observé = {observed:.4f}")
    ax.set_xlabel("MMD")
    ax.set_ylabel("fréquence")
    ax.set_title(f"Test de permutation — {nom_candidat}")
    ax.legend()
    plt.tight_layout()
    plt.show()


# ---------------------------------------------------------------------------
# 4. Projection 2D (UMAP) — X vs candidat, colorée par origine
# ---------------------------------------------------------------------------
def plot_projection_2d(df_x: pd.DataFrame, df_candidat: pd.DataFrame, variables: list,
                        label_candidat: str = "Candidat", n_max: int = 3000,
                        random_state: int = 42):
    """
    Projette X et le candidat sur le même espace 2D via UMAP, colorés par
    origine. Sert de confirmation visuelle des scores quantitatifs (AUC,
    PSI, MMD) — pas de méthode de décision à elle seule.
    """
    import umap
    from sklearn.preprocessing import StandardScaler

    df_c = df_candidat.sample(n=n_max, random_state=random_state) if len(df_candidat) > n_max else df_candidat
    df_x_s = df_x.sample(n=n_max, random_state=random_state) if len(df_x) > n_max else df_x

    combined = pd.concat([df_c[variables], df_x_s[variables]], axis=0, ignore_index=True)
    for col in combined.select_dtypes(include=["object", "category"]).columns:
        combined[col] = combined[col].astype("category").cat.codes
    combined = combined.fillna(combined.median(numeric_only=True))

    scaled = StandardScaler().fit_transform(combined)
    embedding = umap.UMAP(random_state=random_state).fit_transform(scaled)

    n_c = len(df_c)
    fig, ax = plt.subplots(figsize=(6, 5))
    ax.scatter(embedding[:n_c, 0], embedding[:n_c, 1], s=8, alpha=0.5,
               label=label_candidat, color="#1976D2")
    ax.scatter(embedding[n_c:, 0], embedding[n_c:, 1], s=8, alpha=0.5,
               label="X (cible)", color="#F44336")
    ax.set_title(f"Projection UMAP — X vs {label_candidat}")
    ax.legend()
    plt.tight_layout()
    plt.show()


