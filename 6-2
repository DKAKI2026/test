        diag = b.diagnostic_colonnes(df)
        st.success(f"« {st.session_state.df_nom} » chargé : {len(df):,} lignes, {len(df.columns)} colonnes".replace(",", " "))
        if diag["manque"]:
            st.error(f"Colonnes obligatoires manquantes : {diag['manque']}")
        else:
            dfc, rapport, _ = b.nettoyer(df, None)
            if dfc is not df:
                st.session_state.df = dfc
            if rapport:
                for r in rapport:
                    badge("⚠", r)
            else:
                badge("✓", "Aucune valeur manquante ou infinie détectée.")
            st.markdown("**Aperçu**")
            st.dataframe(st.session_state.df.head(50), height=260, use_container_width=True)
            st.markdown("**Résumé statistique**")
            st.dataframe(st.session_state.df.describe().T, use_container_width=True)
    st.markdown("</div>", unsafe_allow_html=True)

    peut_avancer = st.session_state.df is not None and not b.diagnostic_colonnes(st.session_state.df)["manque"]
    pied_navigation(peut_avancer)


# ============================================================================================
# ÉTAPE 1 — Strates & crédibilité
# ============================================================================================
elif etape == 1:
    df = st.session_state.df
    d = b.prep(df)
    colonnes_possibles = [c for c in b.COLONNES_BRUTES + ["PolGrp", "AttdAge"] if c in d.columns]

    kicker("🧩", "Strates & crédibilité", "Choisis un découpage puis confirme, ou continue sans facteur")
    st.markdown("<div class='carte'><h3>Colonnes de la strate</h3>", unsafe_allow_html=True)
    sans = st.checkbox("Continuer sans strate (ne pas travailler avec le facteur)", value=st.session_state.sans_strate)
    if sans != st.session_state.sans_strate:
        st.session_state.sans_strate = sans
        st.session_state.strate_confirmee = False

    # Sélection LIBRE, non confirmée : ne déclenche aucun calcul et ne débloque pas "Suivant".
    choix_libre = st.multiselect("Colonnes de la strate", colonnes_possibles, default=st.session_state.strate,
                                 disabled=sans, help="Choisis tes colonnes, puis clique sur « Confirmer cette strate ».")
    if choix_libre != st.session_state.strate:
        st.session_state.strate = choix_libre
        st.session_state.strate_confirmee = False    # tout changement invalide la confirmation précédente

    c_conf, c_msg = st.columns([1, 3])
    with c_conf:
        if st.button("✅ Confirmer cette strate", disabled=sans or not choix_libre, use_container_width=True):
            st.session_state.strate_confirmee = True
            st.rerun()
    with c_msg:
        if sans:
            st.caption("Aucune strate : le facteur ne sera pas utilisé.")
        elif st.session_state.strate_confirmee:
            st.caption(f"✔ Strate confirmée : `{st.session_state.strate}`. Change la sélection puis reconfirme pour la modifier.")
        elif choix_libre:
            st.caption("Sélection en attente de confirmation — le tableau ci-dessous n'apparaîtra qu'après le clic.")
        else:
            st.caption("Sélectionne au moins une colonne, ou coche « continuer sans strate ».")
    st.markdown("</div>", unsafe_allow_html=True)

    strate = st.session_state.strate
    if not sans and st.session_state.strate_confirmee and strate:
        tab = b.table_strates(d, strate)
        st.session_state.tab_strate = tab
        z100 = tab["Z"] >= 1.0
        st.markdown("<div class='carte'><h3>Crédibilité des strates</h3>", unsafe_allow_html=True)
        m1, m2, m3 = st.columns(3)
        with m1:
            st.markdown(f"<div class='metrique-box'><div class='val'>{len(tab)}</div><div class='lab'>strates</div></div>", unsafe_allow_html=True)
        with m2:
            st.markdown(f"<div class='metrique-box'><div class='val'>{int(z100.sum())}</div><div class='lab'>à 100 % de crédibilité</div></div>", unsafe_allow_html=True)
        with m3:
            st.markdown(f"<div class='metrique-box'><div class='val'>{tab.loc[z100, 'Poids'].sum():.0%}</div><div class='lab'>des prestations couvertes</div></div>", unsafe_allow_html=True)
        st.write("")
        st.caption("🟢 Vert = strate fiable (beaucoup de décès observés). 🟡 Jaune = fiabilité moyenne. "
                  "🔴 Rouge = peu de décès observés : le facteur s'appuie surtout sur la référence, pas sur cette strate.")
        cols_aff = [c for c in strate] + ["Lignes", "Deces", "Attendu", "Reel", "Ratio", "Z", "Fiabilite", "Facteur", "Poids"]
        style = (tab[cols_aff].style
                .format({"Attendu": "{:,.0f}", "Reel": "{:,.0f}", "Ratio": "{:.3f}", "Z": "{:.0%}",
                        "Facteur": "{:.3f}", "Poids": "{:.1%}", "Deces": "{:,.0f}"})
                .map(colorer_fiabilite, subset=["Z"]))
        st.dataframe(style, use_container_width=True, height=320)
        st.markdown("</div>", unsafe_allow_html=True)

        st.markdown("<div class='carte'><h3>🔎 Autres critères de crédibilité (à titre informatif)</h3>", unsafe_allow_html=True)
        st.caption("Ce sont d'autres façons, plus ou moins savantes, de calculer la même idée : à quel point peut-on "
                  "se fier aux données observées plutôt qu'à la table de référence. Elles n'influencent pas le calcul "
                  "du facteur ci-dessus, elles servent juste à vérifier qu'il est raisonnable.")
        blocs = b.criteres_credibilite(d, strate, tab)
        onglets = st.tabs([bl["titre"] for bl in blocs])
        for onglet, bl in zip(onglets, blocs):
            with onglet:
                for s, t, n in bl["lignes"]:
                    badge(s, t, n)
        st.markdown("</div>", unsafe_allow_html=True)
    pied_navigation(sans or (st.session_state.strate_confirmee and bool(strate)))


# ============================================================================================
# ÉTAPE 2 — Facteur : l'utiliser comme point de départ ou non
# ============================================================================================
elif etape == 2:
    kicker("⚖️", "Facteur", "Décide s'il sert de point de départ à l'algorithme")
    st.markdown("<div class='carte'>", unsafe_allow_html=True)
    if st.session_state.sans_strate or not st.session_state.strate:
        st.info("Aucune strate choisie à l'étape précédente : le facteur n'est pas utilisé. "
               "Reviens à l'étape « Strates & crédibilité » si tu changes d'avis.")
        st.session_state.avec_facteur = False
    else:
        st.write(f"Strate retenue : `{st.session_state.strate}`. Le facteur peut servir de **point de départ** "
                "à l'algorithme (celui-ci n'apprend plus que la correction qu'il reste à faire), ou être ignoré "
                "(l'algorithme part directement de la table de mortalité).")
        choix = st.radio("Choix", ["Utiliser le facteur comme point de départ", "Ne pas l'utiliser (repartir de la table seule)"],
                         index=0 if st.session_state.avec_facteur is not False else 1)
        st.session_state.avec_facteur = choix.startswith("Utiliser")
    st.markdown("</div>", unsafe_allow_html=True)

    pied_navigation()


# ============================================================================================
# ÉTAPE 3 — Algorithme + réglages de validation croisée
# ============================================================================================
elif etape == 3:
    kicker("🧠", "Algorithme", "Choisis-le, avec ses réglages de validation croisée")
    st.markdown("<div class='carte'>", unsafe_allow_html=True)
    descr = {
        "LightGBM": "Arbres boostés — précis, mais boîte noire.",
        "GLM + LightGBM": "GLM explicable comme point de départ, LightGBM apprend la correction — précis, semi-explicable.",
        "GLM de Poisson": "Une formule multiplicative, des tables de facteurs — explicable.",
        "GLM Tweedie": "Comme le GLM de Poisson, adapté aux montants très dispersés — explicable.",
        "GAM": "Courbes lisses par variable (âge, durée…) — explicable, plus souple qu'un GLM.",
        "EBM": "Un arbre par variable, courbes lisibles — souvent proche de LightGBM en précision, tout en restant explicable.",
    }
    algo = st.selectbox("Algorithme", b.ALGOS, index=b.ALGOS.index(st.session_state.algo))
    st.session_state.algo = algo
    st.caption(descr[algo])

    d = b.prep(st.session_state.df)
    mode_detecte = "melange (auto)"
    c1, c2, c3 = st.columns(3)
    with c1:
        mode_override = st.selectbox("Mode de validation", ["auto", "melange", "futur"],
                                     index=["auto", "melange", "futur"].index(st.session_state.mode_override),
                                     help="'auto' détecte le mode une fois resultats chargé, à l'étape Entraînement.")
        st.session_state.mode_override = mode_override
    with c2:
        st.session_state.n_splits = st.number_input("Nombre de plis (validation croisée)", 2, 10, st.session_state.n_splits)
    with c3:
        st.session_state.rapide = st.checkbox("Mode rapide (réglages allégés, pour tester)", value=st.session_state.rapide)
    st.caption("💡 En clair : on découpe les données en plusieurs morceaux, on entraîne sur une partie et on vérifie "
              "sur le reste (jamais vu à l'entraînement), pour savoir si le modèle marche vraiment ou s'il a juste "
              "« appris par cœur ». Plus de morceaux = estimation plus fiable, mais plus long à calculer.")

    if algo in ("LightGBM", "GLM + LightGBM"):
        c4, c5 = st.columns(2)
        st.session_state.learning_rate = c4.slider("Taux d'apprentissage (LightGBM)", 0.01, 0.3, st.session_state.learning_rate)
        st.session_state.max_rounds = c5.slider("Nombre maximal d'arbres", 100, 5000, st.session_state.max_rounds, step=100)
    st.markdown("</div>", unsafe_allow_html=True)

    pied_navigation()


# ============================================================================================
# ÉTAPE 4 — Colonnes calculées suggérées
# ============================================================================================
elif etape == 4:
    kicker("➕", "Colonnes calculées", "Décoche celles que tu ne veux pas proposer ensuite")
    st.markdown("<div class='carte'>", unsafe_allow_html=True)
    st.write("Décoche celles que tu ne veux pas proposer à la sélection des colonnes (étape suivante).")
    choix = []
    for col, expl in b.COLONNES_CALCULEES.items():
        coche = st.checkbox(f"**{col}** — {expl}", value=col in st.session_state.cols_calc, key=f"calc_{col}")
        if coche:
            choix.append(col)
    st.session_state.cols_calc = choix
    st.markdown("</div>", unsafe_allow_html=True)

    pied_navigation()


# ============================================================================================
# ÉTAPE 5 — Sélection des colonnes à entraîner (manuelle ou dynamique)
# ============================================================================================
elif etape == 5:
    mode_s5 = st.session_state.mode_override
    if mode_s5 == "auto":
        mode_s5 = "melange"
    d = b.preparer(st.session_state.df, mode_s5)
    candidats = [c for c in b.COLONNES_BRUTES if c in d.columns] + list(st.session_state.cols_calc)
    if st.session_state.avec_facteur:
        candidats = [c for c in candidats if c not in st.session_state.strate]  # évite la redondance avec le facteur

    kicker("🎯", "Sélection des colonnes", "Manuellement, ou automatiquement selon un seuil")
    st.markdown("<div class='carte'>", unsafe_allow_html=True)
    methode = st.radio("Méthode", ["Sélection manuelle", "Sélection dynamique selon un seuil"],
                       index=0 if st.session_state.methode_cols == "manuelle" else 1)
    st.session_state.methode_cols = "manuelle" if methode.startswith("Sélection manuelle") else "dynamique"

    if st.session_state.methode_cols == "manuelle":
        defaut = [c for c in (st.session_state.colonnes_final or candidats[:5]) if c in candidats]
        cols = st.multiselect("Colonnes candidates", candidats, default=defaut)
        st.session_state.colonnes_final = cols
        st.session_state.historique_selection = None
    else:
        st.session_state.seuil_gain = st.number_input(
            "Seuil de gain relatif (une colonne est gardée si elle réduit la déviance d'au moins ce pourcentage)",
            min_value=0.0001, max_value=0.05, value=st.session_state.seuil_gain, step=0.0005, format="%.4f")
        st.caption("💡 En clair : on essaie les colonnes une par une et on ne garde que celles qui améliorent "
                  "vraiment les prédictions. Un seuil bas garde plus de colonnes (modèle plus riche, mais plus "
                  "complexe) ; un seuil haut n'en garde que quelques-unes, les plus utiles.")
        if st.button("Lancer la sélection dynamique", type="primary"):
            mode = st.session_state.mode_override
            if mode == "auto":
                mode = "melange"  # sans resultats chargé, on suppose le mode le plus courant pour la sélection
            zone = st.empty()
            historique = []

            def callback(etape_dict):
                historique.append(etape_dict)
                with zone.container():
                    for e in historique:
                        s = "✓" if e["retenue"] else "⚠"
                        badge(s, f"{e['colonne']} : gain {e['gain']:.2%} (déviance {e['deviance']:,.0f})".replace(",", " "))

            with st.spinner("Sélection en cours..."):
                cols, hist, base_dev = b.selection_dynamique(d, candidats, mode, st.session_state.seuil_gain,
                                                              n_splits=2 if st.session_state.rapide else 3, callback=callback)
            st.session_state.colonnes_final = cols
            st.session_state.historique_selection = hist
        if st.session_state.colonnes_final and st.session_state.historique_selection:
            st.success(f"Colonnes retenues : {st.session_state.colonnes_final}")
    st.markdown("</div>", unsafe_allow_html=True)

    pied_navigation(st.session_state.colonnes_final is not None)


# ============================================================================================
# ÉTAPE 6 — Entraînement, pli par pli, interruptible
# ============================================================================================
elif etape == 6:
    kicker("🚀", "Entraînement", "Un pli à la fois pour pouvoir t'arrêter, ou tous d'un coup")
    st.markdown("<div class='carte'>", unsafe_allow_html=True)
    mode = st.session_state.mode_override
    if mode == "auto":
        mode = "melange"
        st.caption("Mode 'auto' sans fichier resultats chargé : validation en mode 'mélange' par défaut.")
    d = b.preparer(st.session_state.df, mode)

    sig = signature_actuelle()
    if st.session_state.train is None or st.session_state.train_signature != sig:
        params = dict(learning_rate=st.session_state.learning_rate,
                     max_rounds=200 if st.session_state.rapide else st.session_state.max_rounds)
        tab = st.session_state.tab_strate if st.session_state.avec_facteur else None
        st.session_state.train = b.etat_initial(d, st.session_state.algo, st.session_state.colonnes_final, mode,
                                                2 if st.session_state.rapide else st.session_state.n_splits, params,
                                                st.session_state.avec_facteur, st.session_state.strate, tab, None)
        st.session_state.train_signature = sig
        st.session_state.bundle = None
        st.info("Réglages pris en compte : entraînement (ré)initialisé.")

    etat = st.session_state.train
    fait, total = etat["pli_courant"], len(etat["plis"])
    st.progress(fait / total if total else 0, text=f"Pli {fait} / {total}")

    c1, c2, c3 = st.columns(3)
    if c1.button("▶ Entraîner un pli", disabled=etat["termine"], use_container_width=True):
        with st.spinner("Entraînement du pli en cours..."):
            r = b.entrainer_un_pli(etat)
        st.toast(f"Pli {r['pli']}/{r['sur']} terminé en {r['temps']:.1f}s — déviance {r['deviance_pli']:,.0f}".replace(",", " "))
        st.rerun()
    if c2.button("⏭ Entraîner tous les plis restants", disabled=etat["termine"], use_container_width=True,
                help="Non interruptible une fois lancé — préfère 'un pli' si tu veux pouvoir t'arrêter en cours de route."):
        barre = st.progress(0.0)
        while not etat["termine"]:
            r = b.entrainer_un_pli(etat)
            barre.progress(etat["pli_courant"] / total)
        st.rerun()
    if c3.button("⏹ Interrompre / arrêter ici", disabled=fait == 0, use_container_width=True):
        etat["termine"] = True
        etat["interrompu"] = fait < total
        st.rerun()

    if fait > 0:
        histo = pd.DataFrame([dict(Pli=i + 1, Déviance_table=np.nan, Déviance_modèle=np.nan) for i in range(fait)])
        # recalcule les métriques par pli affichées (à partir de oof déjà stocké)
        lignes = []
        for i, (tr, va) in enumerate(etat["plis"][:fait]):
            y_va = d.iloc[va]["DthAmt"].to_numpy(float)
            p_va = etat["oof"][va]
            e_va = d.iloc[va]["ExpecAmt"].to_numpy(float)
            lignes.append(dict(Pli=i + 1, Déviance_table=b.pdev(y_va, e_va), Déviance_modèle=b.pdev(y_va, p_va)))
        histo = pd.DataFrame(lignes)
        st.markdown("**Déviance de Poisson par pli**")
        st.line_chart(histo.set_index("Pli")[["Déviance_table", "Déviance_modèle"]])
        st.dataframe(histo.style.format({"Déviance_table": "{:,.0f}", "Déviance_modèle": "{:,.0f}"}), use_container_width=True)

        resume = b.resume_hors_pli(etat)
        st.caption("💡 En clair : la « déviance » mesure l'écart entre les prédictions et la réalité — plus elle est "
                  "petite, mieux c'est. Le « gain vs table » dit de combien on a amélioré la table de référence "
                  "toute seule : 60 % de gain veut dire qu'on s'est rapproché de la réalité de 60 % par rapport à elle.")
        m1, m2, m3 = st.columns(3)
        with m1:
            st.markdown(f"<div class='metrique-box'><div class='val'>{resume['deviance_modele']:,.0f}</div>"
                       f"<div class='lab'>déviance modèle (hors-pli)</div></div>".replace(",", " "), unsafe_allow_html=True)
        with m2:
            gain = 1 - resume['deviance_modele'] / resume['deviance_table']
            st.markdown(f"<div class='metrique-box'><div class='val'>{gain:.1%}</div><div class='lab'>gain vs table</div></div>", unsafe_allow_html=True)
        with m3:
            st.markdown(f"<div class='metrique-box'><div class='val'>{resume['somme_pred_reel']:.3f}</div><div class='lab'>somme prédite / réelle</div></div>", unsafe_allow_html=True)

    if etat["termine"] and st.session_state.bundle is None:
        if etat.get("interrompu"):
            st.warning(f"Entraînement arrêté après {fait}/{total} plis : l'estimation hors-pli est moins fiable.")
        if st.button("✅ Finaliser le modèle (entraîne sur toutes les données)", type="primary"):
            with st.spinner("Entraînement final..."):
                b.finaliser(etat)
                st.session_state.bundle = b.construire_bundle(etat)
            st.rerun()
    st.markdown("</div>", unsafe_allow_html=True)

    pied_navigation(st.session_state.bundle is not None, texte_suivant="Voir les résultats →")


# ============================================================================================
# ÉTAPE 7 — Résultats : métriques finales, téléchargement du modèle, prédiction sur resultats
# ============================================================================================
elif etape == 7:
    bundle = st.session_state.bundle
    kicker("🏆", "Résultats", "Métriques finales, téléchargement du modèle et de la soumission")
    st.markdown("<div class='carte'>", unsafe_allow_html=True)
    if bundle is None:
        st.warning("Aucun modèle finalisé. Reviens à l'étape Entraînement.")
    else:
        r = bundle["resume"]
        m1, m2, m3, m4 = st.columns(4)
        m1.markdown(f"<div class='metrique-box'><div class='val'>{bundle['algo']}</div><div class='lab'>algorithme</div></div>", unsafe_allow_html=True)
        m2.markdown(f"<div class='metrique-box'><div class='val'>{r['deviance_modele']:,.0f}</div><div class='lab'>déviance hors-pli</div></div>".replace(",", " "), unsafe_allow_html=True)
        m3.markdown(f"<div class='metrique-box'><div class='val'>{1 - r['deviance_modele'] / r['deviance_table']:.1%}</div><div class='lab'>gain vs table</div></div>", unsafe_allow_html=True)
        m4.markdown(f"<div class='metrique-box'><div class='val'>{len(bundle['cols'])}</div><div class='lab'>colonnes utilisées</div></div>", unsafe_allow_html=True)
        st.caption("💡 En clair : le « gain vs table » indique de combien ce modèle fait mieux que la table de "
                  "mortalité brute pour prédire le montant des décès — plus il est élevé, mieux le modèle colle "
                  "à la réalité observée sur tes données.")
        st.write("")
        st.write(f"**Colonnes du modèle :** {bundle['cols']}")
        st.write(f"**Facteur comme point de départ :** {'oui — strate ' + str(bundle['strate']) if bundle['avec_facteur'] else 'non'}")

        st.download_button("💾 Télécharger le modèle entraîné (.pkl)", data=b.bundle_to_bytes(bundle),
                           file_name="modele_montant.pkl", mime="application/octet-stream", use_container_width=True)

        st.markdown("<hr class='separateur'>", unsafe_allow_html=True)
        st.markdown("**Prédire sur un fichier `resultats` (mêmes colonnes que df, sans DthAmt)**")
        fichier_res = st.file_uploader("Glisse-dépose le CSV de resultats", type=["csv"], key="upload_resultats")
        if fichier_res is not None:
            try:
                res = b.lire_csv(fichier_res.getvalue())
                _, _, err = b.nettoyer(st.session_state.df, res)
                if err:
                    st.error(err)
                else:
                    sub = b.predire(bundle, res)
                    st.dataframe(sub.head(30), use_container_width=True)
                    st.download_button("💾 Télécharger la soumission (CSV)", data=sub.to_csv(index=False).encode("utf-8"),
                                       file_name="soumission_montant.csv", mime="text/csv", use_container_width=True)
            except Exception as e:
                st.error(f"Erreur : {e}")
    st.markdown("</div>", unsafe_allow_html=True)

    c1, c2 = st.columns(2)
    with c1:
        if st.session_state.etape > 0 and st.button("← Précédent", use_container_width=True):
            aller(-1)
            st.rerun()
    with c2:
        if st.button("🔄 Recommencer (nouveau df)", use_container_width=True):
            for k in list(st.session_state.keys()):
                del st.session_state[k]
            st.rerun()



































