# SECTION 2 — Préparation des données
# ============================================================================================
def lire_csv(fichier_bytes_ou_chemin, sep=None, decimal="."):
    """Lit un CSV depuis des bytes (upload) ou un chemin. Devine le séparateur si sep=None."""
    if isinstance(fichier_bytes_ou_chemin, (bytes, bytearray)):
        buf = io.BytesIO(fichier_bytes_ou_chemin)
    else:
        buf = fichier_bytes_ou_chemin
    return pd.read_csv(buf, sep=sep, decimal=decimal, engine="python" if sep is None else "c")


def diagnostic_colonnes(df):
    """Colonnes requises manquantes, et colonnes cibles déjà présentes ou non."""
    manque = [c for c in REQUIRED if c not in df.columns]
    return dict(manque=manque, a_target=TARGET in df.columns, colonnes=list(df.columns))


def _lignes_invalides(d, cols):
    x = d[cols].apply(pd.to_numeric, errors="coerce").to_numpy(float)
    return ~np.isfinite(x).all(axis=1)


def nettoyer(df, resultats=None):
    """Nettoyage avant entraînement : retire de df les lignes invalides, bloque si resultats en a.
    Renvoie (df_propre, rapport: list[str], erreur_resultats: str | None)."""
    rapport = []
    for nom, d, cols in (("df", df, REQUIRED + [TARGET]), ("resultats", resultats, REQUIRED)):
        if d is None:
            continue
        for c in cols:
            if c not in d.columns:
                continue
            x = pd.to_numeric(d[c], errors="coerce")
            bad = int((~np.isfinite(x.to_numpy(float))).sum())
            if bad:
                rapport.append(f"{nom} · {c} : {bad:,} valeurs manquantes/infinies".replace(",", " "))
    erreur_res = None
    if resultats is not None:
        cols_ok = [c for c in CRITIQUES if c in resultats.columns]
        bad_r = _lignes_invalides(resultats, cols_ok)
        if bad_r.any():
            erreur_res = (f"{int(bad_r.sum())} lignes de resultats ont une valeur manquante/infinie dans "
                         f"{cols_ok} : impossible de les prédire tant qu'elles ne sont pas corrigées.")
    bad = _lignes_invalides(df, [c for c in CRITIQUES + [TARGET] if c in df.columns])
    n_retirees = int(bad.sum())
    if n_retirees:
        rapport.append(f"ATTENTION : {n_retirees:,} lignes de df retirées de l'entraînement.".replace(",", " "))
        df = df.loc[~bad].copy()
    return df, rapport, erreur_res


def prep(d):
    """Ajoute toutes les colonnes calculées (section COLONNES_CALCULEES)."""
    d = d.copy()
    d["Year"] = pd.to_numeric(d["Year"]).astype(int)
    d["YearStart"] = d["Year"] // 100 + 2000
    d["PolGrp"] = d["PolTypeGrp"].map(GRP_MAP).fillna(9).astype(int)
    if "AttdAge" not in d.columns:
        d["AttdAge"] = d["IssueAge"] + d["PolYear"] - 1
    d["IssueYear"] = d["YearStart"] - d["PolYear"]
    e = d["ExposCnt"].clip(lower=1e-9)
    a = d["ExposAmt"].clip(lower=1e-9)
    d["qx_amt"] = (d["ExpecAmt"] / a).clip(lower=1e-9)
    d["log_qx_amt"] = np.log(d["qx_amt"])
    d["log_avg_size"] = np.log(a / e)
    d["cv2"] = d["ExposAmt2"] * e / a ** 2
    d["log_expos"] = np.log(e)
    d["eff_n"] = a ** 2 / d["ExposAmt2"].clip(lower=1e-9)
    return d


def detecter_mode(df, resultats):
    return "melange" if resultats["Year"].isin(df["Year"]).mean() > 0.9 else "futur"


def cohort_table(src, k=1.0):
    """Table d'agrégats par cohorte (mêmes assurés suivis d'une année à l'autre), montant seulement."""
    g = src.groupby(KEY, sort=False).agg(DA=("DthAmt", "sum"), EA=("ExpecAmt", "sum")).reset_index()
    k_amt = k * src["ExpecAmt"].sum() / max(len(src), 1)
    return g, k_amt


def cohort_from_table(g, k_amt, dst, k=1.0):
    m = dst[KEY].merge(g, on=KEY, how="left").fillna(0.0)
    return pd.DataFrame({"coh_ae_amt": ((m["DA"] + k_amt) / (m["EA"] + k_amt)).values,
                         "coh_log_E": np.log1p(m["EA"]).values}, index=dst.index)


def cohort_apply(src, dst, k=1.0):
    g, k_amt = cohort_table(src, k)
    return cohort_from_table(g, k_amt, dst, k)


def cohort_oof(src, n_splits=5, seed=0):
    """Features de cohorte hors-pli pour les lignes d'entraînement (aucune fuite de la cible propre)."""
    out = pd.DataFrame(index=src.index, columns=["coh_ae_amt", "coh_log_E"], dtype=float)
    for tr, va in KFold(n_splits, shuffle=True, random_state=seed).split(src):
        out.iloc[va] = cohort_apply(src.iloc[tr], src.iloc[va]).values
    return out


def preparer(df, mode):
    """prep() + colonnes de cohorte correctement rattachées (hors-pli en mode 'melange', neutres sinon).
    À utiliser partout où les colonnes calculées (coh_ae_amt, coh_log_E incluses) doivent vraiment exister."""
    d = prep(df)
    if mode == "melange":
        d = pd.concat([d, cohort_oof(d)], axis=1)
    else:
        d["coh_ae_amt"], d["coh_log_E"] = 1.0, 0.0
    return d


def plis(d, mode, n_splits, seed=42):
    if mode == "melange":
        return list(KFold(n_splits, shuffle=True, random_state=seed).split(d))
    ys = np.sort(d["YearStart"].unique())[-min(3, n_splits):]
    yr = d["YearStart"].to_numpy()
    return [(np.where(yr < v)[0], np.where(yr == v)[0]) for v in ys]


def pdev(y, p):
    y, p = np.asarray(y, float), np.clip(np.asarray(p, float), 1e-12, None)
    t = np.where(y > 0, y * np.log(np.where(y > 0, y, 1) / p), 0.0)
    return float(2 * np.sum(t - (y - p)) / len(y))


# ============================================================================================
# SECTION 3 — Facteur par strate + les 5 critères de crédibilité (messages structurés pour l'UI)
# ============================================================================================
def credibilite(deces, n_plein=N_PLEIN):
    return np.minimum(1.0, np.sqrt(np.asarray(deces, float) / n_plein))


def _fmt(x, nd=0):
    """Nombre avec espace comme séparateur de milliers (ex. 3 006), sans toucher au reste de la phrase."""
    return f"{x:,.{nd}f}".replace(",", " ")


def niveau_pct(p):
    """Classe une proportion (0 à 1) en repère simple : rouge (bas), jaune (moyen), vert (haut).
    Seuils : < 33 % = bas, < 67 % = moyen, sinon haut. Utilisé pour colorer la table et les critères."""
    if p is None or not np.isfinite(p):
        return None
    if p < 0.33:
        return "bas"
    if p < 0.67:
        return "moyen"
    return "haut"


def table_strates(d, strate, n_plein=N_PLEIN):
    """d doit déjà être préparé (prep()). Renvoie un DataFrame : une ligne par strate."""
    cols = list(strate) or ["_tout"]
    d2 = d.assign(_tout=0) if not strate else d
    g = (d2.groupby(cols).agg(Lignes=("DthAmt", "size"), Deces=("DthCnt", "sum") if "DthCnt" in d.columns else ("DthAmt", "size"),
                              Attendu=("ExpecAmt", "sum"), Reel=("DthAmt", "sum")).reset_index())
    if "DthCnt" not in d.columns:                      # montant seul disponible : la crédibilité utilise l'exposition
        g["Deces"] = 0.0
    g["Ratio"] = np.where(g["Attendu"] > 0, g["Reel"] / g["Attendu"].where(g["Attendu"] > 0, 1.0), 1.0)
    g["Z"] = credibilite(g["Deces"], n_plein)
    g["Facteur"] = g["Z"] * g["Ratio"]
    g["Poids"] = g["Attendu"] / g["Attendu"].sum()
    g["Fiabilite"] = g["Z"].map(lambda z: {"bas": "Faible", "moyen": "Moyenne", "haut": "Bonne"}[niveau_pct(z)])
    for c in cols:
        if c in LIBELLES:
            g[c + "_libelle"] = g[c].map(LIBELLES[c]).fillna(g[c].astype(str))
    return g.sort_values("Deces", ascending=False).reset_index(drop=True)


def appliquer_facteur(tab, strate, d):
    cols = list(strate) or ["_tout"]
    d2 = d.assign(_tout=0) if not strate else d
    m = d2[cols].merge(tab[cols + ["Facteur"]], on=cols, how="left")
    inconnu = m["Facteur"].isna().to_numpy()
    f = m["Facteur"].fillna(0.0).to_numpy(float)          # strate inconnue -> Z=0 -> facteur 0 (aucun a priori)
    return d["ExpecAmt"].to_numpy(float) * f, f, inconnu


def criteres_credibilite(d, strate, tab, n_plein=N_PLEIN):
    """Les 5 critères, chacun sous forme {titre, lignes: [(symbole, texte, niveau_ou_None)]}.
    'texte' est écrit en langage simple, compréhensible sans connaître le vocabulaire actuariel.
    'niveau' (bas/moyen/haut/None) sert à colorer le message en rouge/jaune/vert quand il porte une proportion.
    Rien ne lève d'exception : une vérification impossible renvoie un ⚠ au lieu de planter."""
    blocs = []

    def bloc(titre, fn):
        lignes = []
        try:
            fn(lignes)
        except Exception as e:
            lignes.append(("⚠", f"Vérification impossible ({type(e).__name__}: {e})", None))
        blocs.append({"titre": titre, "lignes": lignes})

    def racine(lignes):
        z = np.minimum(1.0, np.sqrt(tab["Deces"] / n_plein))
        ecart = float(np.abs(z - tab["Z"]).max())
        lignes.append(("✓" if ecart < 1e-9 else "⚠",
                       f"Règle utilisée : en dessous de {_fmt(n_plein)} décès, on ne fait pas encore pleinement "
                       "confiance à une strate — plus elle a de décès, plus son facteur compte, jusqu'à ce seuil.",
                       None))
        pleines = tab["Z"] >= 1.0
        part = float(tab.loc[pleines, "Poids"].sum())
        lignes.append(("ℹ", f"{int(pleines.sum())} strate(s) sur {len(tab)} ont assez de décès pour être pleinement "
                       f"fiables (100 % de crédibilité), et elles représentent {part:.0%} du montant total attendu.",
                       niveau_pct(part)))

    def intervalle(lignes):
        z90 = float(NormalDist().inv_cdf(0.95))
        z_def = float(math.erf(0.03 * math.sqrt(n_plein) / math.sqrt(2)))
        lignes.append(("✓" if abs(z_def - 0.90) < 0.02 else "⚠",
                       f"Le seuil de {_fmt(n_plein)} décès correspond à une confiance d'environ 90 % que l'écart "
                       "avec la réalité reste faible — une autre façon d'arriver au même seuil que la règle simple.",
                       None))
        if "ExposAmt2" not in d.columns or "ExposCnt" not in d.columns:
            lignes.append(("ℹ", "Les colonnes nécessaires pour affiner ce calcul au montant (et pas seulement au "
                           "nombre de décès) sont absentes : cette vérification est ignorée.", None))
            return
        cols = [c for c in strate] or ["_tout"]
        d2 = d.assign(_tout=0) if not strate else d
        a = d2.groupby(cols).agg(E=("ExposCnt", "sum"), A=("ExposAmt", "sum"), A2=("ExposAmt2", "sum")).reset_index()
        m = tab[cols].merge(a, on=cols, how="left")
        cv2 = np.where(m["A"] > 0, m["A2"] * m["E"] / m["A"] ** 2, 1.0)
        cv2 = np.clip(cv2, 1.0, None)
        seuil = n_plein * cv2
        z_ajuste = np.minimum(1.0, np.sqrt(tab["Deces"].to_numpy(float) / seuil))
        ecart = tab["Z"].to_numpy(float) - z_ajuste
        moins = ecart > 0.10
        w = tab["Poids"].to_numpy(float)
        part = float(w[moins].sum())
        lignes.append(("⚠" if moins.any() else "✓",
                       f"{int(moins.sum())} strate(s), représentant {part:.0%} du montant attendu, ont des capitaux "
                       "très inégaux (quelques grosses polices dominent) : leur crédibilité est peut-être surestimée "
                       "si on ne compte que le nombre de décès.",
                       niveau_pct(1 - part) if moins.any() else "haut"))

    def whitney(lignes):
        K = n_plein / 4
        lignes.append(("✓", "Cette formule donne presque le même résultat que la règle simple : à mi-chemin du "
                       f"seuil ({_fmt(K)} décès), la confiance atteint déjà 50 %.", None))
        z_w = tab["Deces"] / (tab["Deces"] + K)
        ecart = float(np.average(np.abs(tab["Z"] - z_w), weights=tab["Poids"]))
        lignes.append(("ℹ", f"L'écart moyen entre les deux méthodes, pondéré par le poids de chaque strate, "
                       f"est de {ecart:.1%} : les deux règles donnent des résultats proches.",
                       niveau_pct(1 - ecart)))

    def buhlmann(lignes):
        cols = list(strate) or ["_tout"]
        x = d.assign(_tout=0) if not strate else d
        x = x[x["ExpecAmt"] > 0]
        g = x.groupby(cols, sort=False).ngroup().to_numpy()
        r, n = int(g.max()) + 1, len(x)
        if r < 2 or n <= r:
            lignes.append(("⚠", "Pas assez de strates différentes pour appliquer cette méthode ici.", None))
            return
        m = x["ExpecAmt"].to_numpy(float)
        X = (x["DthAmt"] / x["ExpecAmt"]).to_numpy(float)
        mj = np.bincount(g, weights=m)
        Xj = np.bincount(g, weights=m * X) / mj
        mtot = mj.sum()
        Xbar = float((mj * Xj).sum() / mtot)
        v = float(np.bincount(g, weights=m * (X - Xj[g]) ** 2).sum() / (n - r))
        a = float(((mj * (Xj - Xbar) ** 2).sum() - (r - 1) * v) / (mtot - (mj ** 2).sum() / mtot))
        if not (a > 0 and np.isfinite(a) and np.isfinite(v)):
            lignes.append(("⚠", "Les strates ne se distinguent pas assez les unes des autres pour que cette méthode "
                           "apporte quelque chose de plus ici.", None))
            return
        k = v / a
        z_bs = mj / (mj + k)
        moy = float(np.average(z_bs, weights=mj / mtot))
        lignes.append(("✓", "Cette méthode, plus savante, calcule elle-même le seuil de confiance à partir de tes "
                       "données, au lieu d'utiliser un seuil fixe comme les 3 006 décès de la règle simple.", None))
        lignes.append(("ℹ", f"Avec cette méthode, la confiance moyenne (pondérée) dans tes strates est de {moy:.0%} "
                       f"(contre {np.average(tab['Z'], weights=tab['Poids']):.0%} avec la règle simple).",
                       niveau_pct(moy)))

    def bayes(lignes):
        if "ExpecCnt" not in d.columns:
            lignes.append(("ℹ", "La colonne du nombre de décès attendus est absente : cette vérification est ignorée.", None))
            return
        cols = [c for c in strate] or ["_tout"]
        d2 = d.assign(_tout=0) if not strate else d
        a = d2.groupby(cols).agg(E=("ExpecCnt", "sum")).reset_index()
        m = tab[cols].merge(a, on=cols, how="left")
        E = m["E"].to_numpy(float)
        D = tab["Deces"].to_numpy(float)
        ok = np.isfinite(E) & (E > 0)
        E, D, w = E[ok], D[ok], tab["Poids"].to_numpy(float)[ok]
        if len(E) < 2:
            lignes.append(("⚠", "Pas assez de strates différentes pour appliquer cette méthode ici.", None))
            return
        mu = D.sum() / E.sum()
        R = D / E
        tau2 = ((E * (R - mu) ** 2).sum() - mu * (len(E) - 1)) / (E.sum() - (E ** 2).sum() / E.sum())
        if not (tau2 > 0 and np.isfinite(tau2)):
            lignes.append(("⚠", "Les strates ne se distinguent pas assez les unes des autres pour que cette méthode "
                           "apporte quelque chose de plus ici.", None))
            return
        beta = mu / tau2
        Z = E / (E + beta)
        moy = float(np.average(Z, weights=w))
        lignes.append(("✓", "Cette méthode part d'une hypothèse de départ raisonnable (le niveau moyen de tout le "
                       "portefeuille), puis la corrige progressivement à mesure que les données d'une strate "
                       "s'accumulent.", None))
        lignes.append(("ℹ", f"Confiance moyenne (pondérée) obtenue avec cette méthode : {moy:.0%}.", niveau_pct(moy)))

    bloc("Fluctuation limitée, racine carrée", racine)
    bloc("Fluctuation limitée, intervalle de confiance", intervalle)
    bloc("Formule de Whitney N/(N+K)", whitney)
    bloc("Bühlmann / Bühlmann-Straub", buhlmann)
    bloc("Bayésienne (Poisson-Gamma)", bayes)
    return blocs




# ============================================================================================
# SECTION 4 — Sélection dynamique des colonnes (forward selection, GLM comme éclaireur rapide)
# ============================================================================================
def _glm_ratio_oof(d, cols, plis_):
    from sklearn.linear_model import PoissonRegressor
    from sklearn.compose import ColumnTransformer
    from sklearn.preprocessing import OneHotEncoder, SplineTransformer
    from sklearn.pipeline import Pipeline
    num = [c for c in cols if c in ("AttdAge", "PolYear", "IssueAge", "YearStart", "log_qx_amt",
                                    "log_avg_size", "log_expos", "coh_log_E", "coh_ae_amt", "cv2")]
    cat = [c for c in cols if c not in num]
    o = np.ones(len(d))
    if not cols:
        return o
    blocs = []
    if cat:
        blocs.append(("cat", OneHotEncoder(handle_unknown="ignore"), cat))
    if num:
        blocs.append(("num", SplineTransformer(n_knots=5, degree=3, extrapolation="constant"), num))
    E, y = d["ExpecAmt"].to_numpy(float), d["DthAmt"].to_numpy(float)
    for tr, va in plis_:
        pipe = Pipeline([("prep", ColumnTransformer(blocs, sparse_threshold=1.0)),
                         ("glm", PoissonRegressor(alpha=1e-4, max_iter=400))])
        pipe.fit(d.iloc[tr][cols], y[tr] / np.clip(E[tr], 1e-9, None), glm__sample_weight=E[tr])
        o[va] = np.clip(pipe.predict(d.iloc[va][cols]), 1e-3, 1e2)
    return o


def selection_dynamique(d, candidats, mode, seuil_gain, n_splits=3, callback=None):
    """Forward selection. callback(etape_dict) est appelé après chaque étape (pour affichage live)."""
    plis_ = plis(d, mode, n_splits)
    y, E = d["DthAmt"].to_numpy(float), d["ExpecAmt"].to_numpy(float)
    base_dev = pdev(y, E)
    retenues, restantes = [], [c for c in candidats if c in d.columns]
    dev_actuelle = base_dev
    historique = []
    while restantes:
        gains = {c: pdev(y, E * _glm_ratio_oof(d, retenues + [c], plis_)) for c in restantes}
        meilleure = min(gains, key=gains.get)
        gain_rel = 1 - gains[meilleure] / dev_actuelle
        etape = dict(colonne=meilleure, deviance=gains[meilleure], gain=gain_rel, retenue=gain_rel >= seuil_gain,
                    gain_total=1 - gains[meilleure] / base_dev)
        historique.append(etape)
        if callback:
            callback(etape)
        if gain_rel < seuil_gain:
            break
        retenues.append(meilleure)
        restantes.remove(meilleure)
        dev_actuelle = gains[meilleure]
    return retenues, historique, base_dev


# ============================================================================================
# SECTION 5 — Algorithmes : chacun expose  fit(d_tr, d_va, cols, params, facteur_tr, facteur_va) -> (p_va, model)
#   facteur_* : point de départ optionnel (Z x ratio de la strate), ou None si pas de facteur.
# ============================================================================================
def _mapping(d, cols):
    m = {}
    for c in cols:
        if c in d.columns and not pd.api.types.is_numeric_dtype(d[c]):
            m[c] = {v: i for i, v in enumerate(sorted(d[c].astype(str).unique()))}
    return m


def _X_num(d, cols, mapping):
    X = d[cols].copy() if cols else pd.DataFrame(index=d.index)
    for c, mp in mapping.items():
        X[c] = d[c].astype(str).map(mp).fillna(-1)
    return X.astype(float)


def _point_depart(d, F):
    return d["ExpecAmt"].to_numpy(float) * (np.ones(len(d)) if F is None else np.maximum(F, 1e-3))


class ModeleFit:
    """Petit conteneur générique : garde ce qu'il faut pour repredire plus tard."""
    def __init__(self, algo, payload, mapping=None, cols=None):
        self.algo, self.payload, self.mapping, self.cols = algo, payload, mapping, cols

    def predict(self, d, cols=None, F=None):
        cols = cols if cols is not None else self.cols
        base = _point_depart(d, F)
        if self.algo == "LightGBM":
            import lightgbm as lgb
            X = _X_num(d, cols, self.mapping)
            b = lgb.Booster(model_str=self.payload)
            return base * np.exp(b.predict(X, raw_score=True))
        if self.algo == "GLM + LightGBM":
            import lightgbm as lgb
            ratio = np.clip(self.payload["glm"].predict(d[cols]), 1e-3, 1e2) if cols else np.ones(len(d))
            X = _X_num(d, cols, self.mapping)
            corr = np.exp(lgb.Booster(model_str=self.payload["lgb"]).predict(X, raw_score=True))
            return base * ratio * corr
        if self.algo in ("GLM de Poisson", "GLM Tweedie"):
            ratio = np.clip(self.payload.predict(d[cols]), 1e-3, 1e2) if cols else np.ones(len(d))
            return base * ratio
        if self.algo == "GAM":
            Xn = _X_num(d, cols, self.mapping).to_numpy()
            ratio = np.clip(self.payload.predict(Xn), 1e-3, 1e2)
            return base * ratio
        if self.algo == "EBM":
            X = _X_num(d, cols, self.mapping)
            ratio = np.clip(self.payload.predict(X), 1e-3, 1e2)
            return base * ratio
        raise ValueError(self.algo)


def _glm_pipeline(cols):
    from sklearn.linear_model import PoissonRegressor
    from sklearn.compose import ColumnTransformer
    from sklearn.preprocessing import OneHotEncoder, SplineTransformer
    from sklearn.pipeline import Pipeline
    num = [c for c in cols if c in ("AttdAge", "PolYear", "IssueAge", "YearStart", "log_qx_amt",
                                    "log_avg_size", "log_expos", "coh_log_E", "coh_ae_amt", "cv2")]
    cat = [c for c in cols if c not in num]
    blocs = []
    if cat:
        blocs.append(("cat", OneHotEncoder(handle_unknown="ignore"), cat))
    if num:
        blocs.append(("num", SplineTransformer(n_knots=5, degree=3, extrapolation="constant"), num))
    return Pipeline([("prep", ColumnTransformer(blocs, sparse_threshold=1.0)), ("glm", PoissonRegressor(alpha=1e-4, max_iter=400))])


def fit_algo(algo, d_tr, d_va, cols, params, F_tr=None, F_va=None, seed=0):
    y_tr, y_va = d_tr["DthAmt"].to_numpy(float), d_va["DthAmt"].to_numpy(float)
    base_tr, base_va = _point_depart(d_tr, F_tr), _point_depart(d_va, F_va)

    if algo in ("GLM de Poisson", "GLM Tweedie"):
        from sklearn.linear_model import TweedieRegressor
        z = y_tr / np.clip(base_tr, 1e-9, None)
        if algo == "GLM de Poisson":
            pipe = _glm_pipeline(cols)
        else:
            from sklearn.compose import ColumnTransformer
            from sklearn.preprocessing import OneHotEncoder, SplineTransformer
            from sklearn.pipeline import Pipeline
            num = [c for c in cols if c in ("AttdAge", "PolYear", "IssueAge", "YearStart", "log_qx_amt",
                                            "log_avg_size", "log_expos", "coh_log_E", "coh_ae_amt", "cv2")]
            cat = [c for c in cols if c not in num]
            blocs = ([("cat", OneHotEncoder(handle_unknown="ignore"), cat)] if cat else []) + \
                    ([("num", SplineTransformer(n_knots=5, degree=3, extrapolation="constant"), num)] if num else [])
            pipe = Pipeline([("prep", ColumnTransformer(blocs, sparse_threshold=1.0)),
                             ("glm", TweedieRegressor(power=1.5, link="log", alpha=1e-4, max_iter=400))])
        if cols:
            pipe.fit(d_tr[cols], z, glm__sample_weight=base_tr)
            ratio_va = np.clip(pipe.predict(d_va[cols]), 1e-3, 1e2)
        else:
            ratio_va = np.ones(len(d_va))
        return base_va * ratio_va, ModeleFit(algo, pipe, cols=cols)

    if algo == "GAM":
        from pygam import PoissonGAM, s, f
        mapping = _mapping(d_tr, cols)
        Xtr, Xva = _X_num(d_tr, cols, mapping), _X_num(d_va, cols, mapping)
        if not cols:
            return base_va, ModeleFit(algo, None, mapping, cols)
        terms = None
        for i, c in enumerate(cols):
            t = f(i) if c in mapping or c in ("Sex", "Smoke", "PolGrp", "PolTypeGrp", "Base", "Par", "Size") else s(i)
            terms = t if terms is None else terms + t
        z_tr = y_tr / np.clip(base_tr, 1e-9, None)                     # cible = ratio (comme le GLM)
        w_tr = np.clip(base_tr, 1e-9, None)
        w_tr = w_tr / w_tr.mean()                                      # poids normalisés : évite les débordements numériques
        gam = PoissonGAM(terms, verbose=False)
        try:
            gam.fit(Xtr.to_numpy(), z_tr, weights=w_tr)
        except Exception:                                              # divergence possible sur des données difficiles
            gam = PoissonGAM(terms, lam=10, verbose=False)              # on retente avec une pénalité plus forte
            gam.fit(Xtr.to_numpy(), z_tr, weights=w_tr)
        ratio_va = np.clip(gam.predict(Xva.to_numpy()), 1e-3, 1e2)
        return base_va * ratio_va, ModeleFit(algo, gam, mapping, cols)

    if algo == "EBM":
        from interpret.glassbox import ExplainableBoostingRegressor
        mapping = _mapping(d_tr, cols)
        Xtr, Xva = _X_num(d_tr, cols, mapping), _X_num(d_va, cols, mapping)
        if not cols:
            return base_va, ModeleFit(algo, None, mapping, cols)
        w_tr = np.clip(base_tr, 1e-9, None)
        w_tr = w_tr / w_tr.mean()
        m = ExplainableBoostingRegressor(objective="poisson_deviance", random_state=seed,
                                         max_rounds=params.get("max_rounds", 2000))
        m.fit(Xtr, y_tr / np.clip(base_tr, 1e-9, None), sample_weight=w_tr)
        ratio_va = np.clip(m.predict(Xva), 1e-3, 1e2)
        return base_va * ratio_va, ModeleFit(algo, m, mapping, cols)

    # LightGBM et GLM + LightGBM
    import lightgbm as lgb
    mapping = _mapping(d_tr, cols)
    Xtr, Xva = _X_num(d_tr, cols, mapping), _X_num(d_va, cols, mapping)
    if algo == "GLM + LightGBM" and cols:
        glm = _glm_pipeline(cols)
        z_glm = y_tr / np.clip(base_tr, 1e-9, None)
        glm.fit(d_tr[cols], z_glm, glm__sample_weight=base_tr)
        r_tr = np.clip(glm.predict(d_tr[cols]), 1e-3, 1e2)
        r_va = np.clip(glm.predict(d_va[cols]), 1e-3, 1e2)
        base_tr, base_va = base_tr * r_tr, base_va * r_va
    else:
        glm = None
    ztr = y_tr / np.clip(base_tr, 1e-9, None)
    zva = y_va / np.clip(base_va, 1e-9, None)
    p = dict(objective="poisson", learning_rate=params.get("learning_rate", 0.05), num_leaves=31,
            min_data_in_leaf=50, feature_fraction=0.9, lambda_l2=10.0, verbose=-1, seed=seed)
    dtr = lgb.Dataset(Xtr, ztr, weight=base_tr)
    dva = lgb.Dataset(Xva, zva, weight=base_va, reference=dtr)
    b = lgb.train(p, dtr, params.get("max_rounds", 2000), valid_sets=[dva],
                  callbacks=[lgb.early_stopping(100, verbose=False)])
    p_va = base_va * np.exp(b.predict(Xva, raw_score=True, num_iteration=b.best_iteration))
    payload = dict(glm=glm, lgb=b.model_to_string(num_iteration=b.best_iteration)) if algo == "GLM + LightGBM" \
        else b.model_to_string(num_iteration=b.best_iteration)
    return p_va, ModeleFit(algo, payload, mapping, cols)


def fit_final(algo, d, cols, params, F=None, seed=0):
    """Ajuste sur TOUTES les lignes de d (après validation), pour le modèle final."""
    _, modele = fit_algo(algo, d, d, cols, params, F, F, seed)
    return modele


# ============================================================================================
# SECTION 6 — Entraînement pli par pli (repris/interrompu entre deux appels)
# ============================================================================================
def etat_initial(d, algo, cols, mode, n_splits, params, avec_facteur, strate, tab_facteur, seuil_facteur):
    return dict(d=d, algo=algo, cols=cols, mode=mode, n_splits=n_splits, params=params,
               avec_facteur=avec_facteur, strate=strate, tab_facteur=tab_facteur,
               plis=plis(d, mode, n_splits), pli_courant=0, oof=np.full(len(d), np.nan),
               modeles=[], temps_par_pli=[], termine=False, interrompu=False)


def entrainer_un_pli(etat, seed=0):
    """Entraîne UN pli, met à jour etat en place, renvoie un résumé de l'étape (pour affichage live)."""
    k = etat["pli_courant"]
    tr, va = etat["plis"][k]
    d, cols = etat["d"], etat["cols"]
    d_tr, d_va = d.iloc[tr], d.iloc[va]
    F_tr = F_va = None
    if etat["avec_facteur"]:
        # crédibilité recalculée sur le pli d'entraînement seulement (hors-pli, sans fuite)
        tab_tr = table_strates(d_tr, etat["strate"])
        F_tr = appliquer_facteur(tab_tr, etat["strate"], d_tr)[1]
        F_va = appliquer_facteur(tab_tr, etat["strate"], d_va)[1]
    t0 = time.time()
    p_va, modele = fit_algo(etat["algo"], d_tr, d_va, cols, etat["params"], F_tr, F_va, seed)
    dt = time.time() - t0
    etat["oof"][va] = p_va
    etat["modeles"].append(modele)
    etat["temps_par_pli"].append(dt)
    etat["pli_courant"] += 1
    if etat["pli_courant"] >= len(etat["plis"]):
        etat["termine"] = True
    y_va = d_va["DthAmt"].to_numpy(float)
    return dict(pli=k + 1, sur=len(etat["plis"]), temps=dt, deviance_pli=pdev(y_va, p_va),
               deviance_table_pli=pdev(y_va, d_va["ExpecAmt"].to_numpy(float)))


def resume_hors_pli(etat):
    cov = ~np.isnan(etat["oof"])
    d = etat["d"]
    y, e = d["DthAmt"].to_numpy(float)[cov], d["ExpecAmt"].to_numpy(float)[cov]
    return dict(n=int(cov.sum()), deviance_table=pdev(y, e), deviance_modele=pdev(y, etat["oof"][cov]),
               somme_pred_reel=float(etat["oof"][cov].sum() / y.sum()))


def finaliser(etat, seed=0):
    """Modèle final : réentraîne sur TOUTES les lignes de df avec les plis déjà faits (moyenne des poids
    d'arbres) — ici simplifié : réajuste une dernière fois sur tout d."""
    d = etat["d"]
    F = None
    if etat["avec_facteur"]:
        tab_all = table_strates(d, etat["strate"])
        F = appliquer_facteur(tab_all, etat["strate"], d)[1]
        etat["tab_facteur_finale"] = tab_all
    if etat["mode"] == "melange" and any(c in etat["cols"] for c in ("coh_ae_amt", "coh_log_E")):
        etat["coh_g"], etat["coh_k_amt"] = cohort_table(d)     # table complète (pas hors-pli) pour prédire sur resultats
    modele = fit_final(etat["algo"], d, etat["cols"], etat["params"], F, seed)
    etat["modele_final"] = modele
    return modele


# ============================================================================================
# SECTION 7 — Sauvegarde, chargement, prédiction sur resultats
# ============================================================================================
def construire_bundle(etat):
    return dict(algo=etat["algo"], cols=etat["cols"], mode=etat["mode"], avec_facteur=etat["avec_facteur"],
               strate=etat["strate"], tab_facteur=etat.get("tab_facteur_finale"), modele=etat["modele_final"],
               coh_g=etat.get("coh_g"), coh_k_amt=etat.get("coh_k_amt"), resume=resume_hors_pli(etat))


def bundle_to_bytes(bundle):
    return pickle.dumps(bundle)


def bundle_from_bytes(b):
    return pickle.loads(b)


def predire(bundle, resultats):
    res = prep(resultats).reset_index(drop=True)
    if bundle.get("coh_g") is not None:
        res = pd.concat([res, cohort_from_table(bundle["coh_g"], bundle["coh_k_amt"], res)], axis=1)
    elif any(c in bundle["cols"] for c in ("coh_ae_amt", "coh_log_E")):
        res["coh_ae_amt"], res["coh_log_E"] = 1.0, 0.0      # mode 'futur' : pas de cohorte, valeurs neutres
    F = None
    if bundle["avec_facteur"]:
        F = appliquer_facteur(bundle["tab_facteur"], bundle["strate"], res)[1]
    amt = bundle["modele"].predict(res, bundle["cols"], F)
    sub = resultats.copy()
    sub["DthAmt"] = np.clip(amt, 0, None)
    return sub



















































































