# -*- coding: utf-8 -*-
"""
Prédire DthCnt et DthAmt — LightGBM — VERSION 2 (corrige un gain négatif vs ICA).

Corrections par rapport à la version 1
  1. RÉENTRAÎNEMENT SUR TOUT df : la v1 prédisait avec les modèles des plis, qui n'avaient
     jamais vu les années les plus récentes (mode temporal). La v2 réentraîne sur tout df
     avec le nombre d'itérations trouvé en validation.
  2. VALIDATION TEMPORELLE par défaut (3 dernières années), même en mode interleaved :
     plus réaliste, moins optimiste que des plis aléatoires.
  3. RÉGULARISATION plus forte (arbres plus petits, feuilles plus grosses).
  4. FILET DE SÉCURITÉ « rétrécissement vers l'ICA » :
         pred = ICA x (modele/ICA)^alpha x f
     alpha dans [0,1] choisi sur la validation. alpha=0 -> ICA recalibrée pure,
     donc sur la validation le modèle ne peut pas faire pire que l'ICA recalibrée.
  5. DIAGNOSTIC « niveau vs forme » pour savoir d'où vient l'écart.

Utilisation (resultats AVEC les vraies DthCnt / DthAmt) :
    sub = tester(df, resultats, rapide=True)   # test rapide
    sub = tester(df, resultats)                # complet
"""
import pickle

import numpy as np
import pandas as pd
import lightgbm as lgb
from sklearn.model_selection import KFold


# ============================================================================================
# SECTION 1 — Constantes
# ============================================================================================
TARGETS = ["DthCnt", "DthAmt"]
REQUIRED = ["Year", "Sex", "Smoke", "PolTypeGrp", "Base", "Par", "Size", "IssueAge",
            "PolYear", "ExposCnt", "ExposAmt", "ExposAmt2", "ExpecCnt", "ExpecAmt"]
CRITIQUES = ["Year", "Size", "IssueAge", "PolYear", "ExposCnt", "ExposAmt", "ExpecCnt", "ExpecAmt"]

KEY = ["Sex", "Smoke", "PolGrp", "Base", "Par", "Size", "IssueAge", "IssueYear"]
GRP_MAP = {1: 1, 2: 2, 3: 3, 4: 3, 5: 3, 11: 3, 6: 6, 7: 6, 10: 6, 8: 8, 9: 9}

FEATS_BASE = ["YearStart", "Sex", "Smoke", "PolGrp", "PolTypeGrp", "Base", "Par", "Size",
              "IssueAge", "PolYear", "AttdAge", "IssueYear", "log_qx", "log_qx_ratio",
              "log_avg_size", "cv2", "log_expos"]
FEATS_COH = ["coh_ae_cnt", "coh_ae_amt", "coh_log_E"]

# Régularisation plus forte que la v1
PARAMS = dict(learning_rate=0.03, num_leaves=15, min_data_in_leaf=1000, feature_fraction=0.7,
              bagging_fraction=0.8, bagging_freq=1, lambda_l2=50.0, verbose=-1)
# Modèle nombre : chaque feuille doit contenir au moins ~5 décès attendus
EXTRA_CNT = dict(min_sum_hessian_in_leaf=5.0)


# ============================================================================================
# SECTION 2 — Métrique
# ============================================================================================
def dev_lignes(y, p):
    y = np.asarray(y, dtype=float)
    p = np.clip(np.asarray(p, dtype=float), 1e-12, None)
    terme = np.where(y > 0, y * np.log(np.where(y > 0, y, 1) / p), 0.0)
    return 2 * (terme - (y - p))


def METRIC(y, p):
    return float(np.sum(dev_lignes(y, p)))


def pdev(y, p):
    return METRIC(y, p) / max(len(np.asarray(y)), 1)


def rep(name, y, p, ref=None):
    d = METRIC(y, p)
    gain = f"  gain vs ICA={1 - d / ref:+.2%}" if ref else ""
    print(f"  {name:<46s} dev_tot={d:>18,.1f}  pred/reel={np.sum(p) / np.sum(y):.4f}{gain}")
    return d


# ============================================================================================
# SECTION 3 — Préparation des variables
# ============================================================================================
def prep(d):
    d = d.copy()
    d["Year"] = pd.to_numeric(d["Year"]).astype(int)
    d["YearStart"] = d["Year"] // 100 + 2000
    d["PolGrp"] = d["PolTypeGrp"].map(GRP_MAP).fillna(9).astype(int)
    if "AttdAge" not in d.columns:
        d["AttdAge"] = d["IssueAge"] + d["PolYear"] - 1
    d["IssueYear"] = d["YearStart"] - d["PolYear"]
    e = d["ExposCnt"].clip(lower=1e-9)
    a = d["ExposAmt"].clip(lower=1e-9)
    d["qx_cnt"] = (d["ExpecCnt"] / e).clip(lower=1e-9)
    d["qx_amt"] = (d["ExpecAmt"] / a).clip(lower=1e-9)
    d["log_qx"] = np.log(d["qx_cnt"])
    d["log_qx_ratio"] = np.log(d["qx_amt"] / d["qx_cnt"])
    d["log_avg_size"] = np.log(a / e)
    d["cv2"] = d["ExposAmt2"] * e / a ** 2
    d["log_expos"] = np.log(e)
    d["eff_n"] = a ** 2 / d["ExposAmt2"].clip(lower=1e-9)
    return d


# ============================================================================================
# SECTION 4 — Variables de cohorte
# ============================================================================================
def cohort_table(src, k=1.0):
    g = (src.groupby(KEY, sort=False)
            .agg(D=("DthCnt", "sum"), E=("ExpecCnt", "sum"),
                 DA=("DthAmt", "sum"), EA=("ExpecAmt", "sum"))
            .reset_index())
    k_amt = k * src["ExpecAmt"].sum() / max(src["ExpecCnt"].sum(), 1e-9)
    return g, k_amt


def cohort_from_table(g, k_amt, dst, k=1.0):
    m = dst[KEY].merge(g, on=KEY, how="left").fillna(0.0)
    return pd.DataFrame({
        "coh_ae_cnt": ((m["D"] + k) / (m["E"] + k)).values,
        "coh_ae_amt": ((m["DA"] + k_amt) / (m["EA"] + k_amt)).values,
        "coh_log_E": np.log1p(m["E"]).values}, index=dst.index)


def cohort_apply(src, dst, k=1.0):
    g, k_amt = cohort_table(src, k)
    return cohort_from_table(g, k_amt, dst, k)


def cohort_oof(src, n_splits=5, seed=0):
    out = pd.DataFrame(index=src.index, columns=FEATS_COH, dtype=float)
    for tr, va in KFold(n_splits, shuffle=True, random_state=seed).split(src):
        out.iloc[va] = cohort_apply(src.iloc[tr], src.iloc[va]).values
    return out


# ============================================================================================
# SECTION 5 — Entraînement
# ============================================================================================
def fit(Xtr, ytr, otr, wtr, Xva, yva, ova, wva, seed, max_rounds, params):
    p = dict(params, objective="poisson", seed=seed)
    dtr = lgb.Dataset(Xtr, ytr, weight=wtr, init_score=otr)
    dva = lgb.Dataset(Xva, yva, weight=wva, init_score=ova, reference=dtr)
    return lgb.train(p, dtr, max_rounds, valid_sets=[dva],
                     callbacks=[lgb.early_stopping(100, verbose=False)])


def fit_full(X, y, o, w, seed, rounds, params):
    """Entraînement sur TOUT df avec un nombre d'itérations fixé (trouvé en validation)."""
    p = dict(params, objective="poisson", seed=seed)
    return lgb.train(p, lgb.Dataset(X, y, weight=w, init_score=o), rounds)


def raw(m, X):
    return m.predict(X, raw_score=True, num_iteration=m.best_iteration)


def cnt_targets(d):
    return d["DthCnt"].values, np.log(d["ExpecCnt"].clip(lower=1e-9)).values


def amt_targets(d, w0):
    y = (d["DthAmt"] / d["ExposAmt"].clip(lower=1e-9)).values
    return y, np.log(d["qx_amt"]).values, (d["eff_n"] / w0).values


def make_folds(df, validation, n_splits, seed=42):
    if validation == "interleaved":
        return list(KFold(n_splits, shuffle=True, random_state=seed).split(df))
    ys = np.sort(df["YearStart"].unique())[-3:]          # 3 dernières années
    yr = df["YearStart"].values
    return [(np.where(yr < v)[0], np.where(yr == v)[0]) for v in ys]


# ---- Rétrécissement vers l'ICA (filet de sécurité) ----------------------------------------
def shrink(p, base, alpha):
    base = np.clip(np.asarray(base, float), 1e-9, None)
    p = np.clip(np.asarray(p, float), 1e-12, None)
    return base * (p / base) ** alpha


def choisir_alpha(y, p, base, grille=np.linspace(0, 1, 11)):
    """alpha et facteur f qui minimisent la déviance de  f * ICA * (p/ICA)^alpha."""
    best = None
    for a in grille:
        q = shrink(p, base, a)
        f = y.sum() / q.sum()
        d = METRIC(y, f * q)
        if best is None or d < best[0]:
            best = (d, float(a), float(f))
    return best[1], best[2]


# ============================================================================================
# SECTION 6 — Sauvegarde, chargement, prédiction
# ============================================================================================
def save_bundle(bundle, path):
    with open(path, "wb") as f:
        pickle.dump(bundle, f)


def load_bundle(path):
    with open(path, "rb") as f:
        return pickle.load(f)


def predict(bundle, resultats):
    miss = [c for c in REQUIRED if c not in resultats.columns]
    assert not miss, f"Colonnes manquantes : {miss}"
    res = prep(resultats).reset_index(drop=True)
    if bundle["mode"] == "interleaved":
        res = pd.concat([res, cohort_from_table(bundle["coh_g"], bundle["coh_k_amt"], res,
                                                bundle["coh_k"])], axis=1)
    X = res[bundle["feats"]]
    off_c = np.log(res["ExpecCnt"].clip(lower=1e-9)).values
    off_a = np.log(res["qx_amt"]).values
    te_c = np.mean([np.exp(lgb.Booster(model_str=m).predict(X, raw_score=True) + off_c)
                    for m in bundle["models_c"]], axis=0)
    te_a = np.mean([res["ExposAmt"].values * np.exp(lgb.Booster(model_str=m).predict(X, raw_score=True) + off_a)
                    for m in bundle["models_a"]], axis=0)
    b_te = te_c * np.exp(res["log_avg_size"].values) * \
        pd.Series(bundle["calib_size"]).reindex(res["Size"].values).fillna(1).values
    w = bundle["w_blend"]
    blend = w * te_a + (1 - w) * b_te
    sub = resultats.copy().reset_index(drop=True)
    sub["DthCnt"] = np.clip(shrink(te_c, res["ExpecCnt"].values, bundle["alpha_c"]) * bundle["f_c"], 0, None)
    sub["DthAmt"] = np.clip(shrink(blend, res["ExpecAmt"].values, bundle["alpha_a"]) * bundle["f_a"], 0, None)
    return sub


# ============================================================================================
# SECTION 7 — Contrôle des données + pipeline d'entraînement
# ============================================================================================
def _lignes_invalides(d, cols):
    x = d[cols].apply(pd.to_numeric, errors="coerce").to_numpy(float)
    return ~np.isfinite(x).all(axis=1)


def verifier_donnees(df, resultats=None):
    if resultats is not None:
        bad_r = _lignes_invalides(resultats, CRITIQUES)
        assert not bad_r.any(), (f"{int(bad_r.sum())} lignes de resultats invalides dans {CRITIQUES} "
                                 f"(index : {list(resultats.index[bad_r][:5])}).")
    bad = _lignes_invalides(df, CRITIQUES + TARGETS)
    if bad.any():
        print(f"ATTENTION : {int(bad.sum()):,} lignes de df retirees (valeur manquante/infinie).")
        df = df.loc[~bad]
    else:
        print("Controle des donnees : aucun probleme detecte.")
    return df


def run(df, mode, validation="temporal", n_splits=5, seeds=(0, 1, 2), max_rounds=3000,
        params=None, verbose=True, save_path=None):
    params = dict(PARAMS, **(params or {}))
    p_cnt = dict(params, **EXTRA_CNT)
    miss = [c for c in REQUIRED + TARGETS if c not in df.columns]
    assert not miss, f"Colonnes manquantes : {miss}"

    df = prep(df).reset_index(drop=True)
    use_coh = mode == "interleaved"
    feats = FEATS_BASE + (FEATS_COH if use_coh else [])
    if not use_coh:
        feats = [f for f in feats if f not in ("YearStart", "IssueYear")]
    w0 = df["eff_n"].mean()
    if verbose:
        print(f"Mode prediction : {mode} | validation : {validation} | lignes df={len(df):,} | {len(feats)} features")

    # ---------- 1) Validation : prédictions hors-pli + nombre d'itérations ----------
    n = len(df)
    oof_c, oof_a = np.full(n, np.nan), np.full(n, np.nan)
    it_c, it_a = [], []
    for k, (tr, va) in enumerate(make_folds(df, validation, n_splits)):
        d_tr0, d_va0 = df.iloc[tr], df.iloc[va]
        if use_coh:
            d_tr = pd.concat([d_tr0, cohort_oof(d_tr0, seed=k)], axis=1)
            d_va = pd.concat([d_va0, cohort_apply(d_tr0, d_va0)], axis=1)
        else:
            d_tr, d_va = d_tr0, d_va0
        yc_tr, oc_tr = cnt_targets(d_tr); yc_va, oc_va = cnt_targets(d_va)
        ya_tr, oa_tr, wa_tr = amt_targets(d_tr, w0); ya_va, oa_va, wa_va = amt_targets(d_va, w0)
        pc_va, pa_va = np.zeros(len(va)), np.zeros(len(va))
        for s in seeds:
            mc = fit(d_tr[feats], yc_tr, oc_tr, None, d_va[feats], yc_va, oc_va, None, s, max_rounds, p_cnt)
            ma = fit(d_tr[feats], ya_tr, oa_tr, wa_tr, d_va[feats], ya_va, oa_va, wa_va, s, max_rounds, params)
            pc_va += np.exp(raw(mc, d_va[feats]) + oc_va) / len(seeds)
            pa_va += d_va["ExposAmt"].values * np.exp(raw(ma, d_va[feats]) + oa_va) / len(seeds)
            it_c.append(max(mc.best_iteration, 1)); it_a.append(max(ma.best_iteration, 1))
        oof_c[va], oof_a[va] = pc_va, pa_va
        if verbose:
            print(f"  pli {k + 1}: iter cnt={mc.best_iteration}, iter amt={ma.best_iteration}")

    cov = ~np.isnan(oof_c)
    yc, ya = df["DthCnt"].values[cov], df["DthAmt"].values[cov]
    bc, ba = df["ExpecCnt"].values[cov], df["ExpecAmt"].values[cov]

    # ---------- 2) Blend du montant ----------
    avg_size = np.exp(df["log_avg_size"].values)
    calib = (pd.Series(ya).groupby(df["Size"].values[cov]).sum() /
             pd.Series(oof_c[cov] * avg_size[cov]).groupby(df["Size"].values[cov]).sum()
             ).replace([np.inf, -np.inf], 1).fillna(1)
    b_oof = oof_c[cov] * avg_size[cov] * calib.reindex(df["Size"].values[cov]).fillna(1).values
    a_oof = oof_a[cov]
    ws = np.linspace(0, 1, 11)
    w_best = float(ws[int(np.argmin([METRIC(ya, w * a_oof + (1 - w) * b_oof) for w in ws]))])
    blend_oof = w_best * a_oof + (1 - w_best) * b_oof

    # ---------- 3) Rétrécissement vers l'ICA + calibration ----------
    alpha_c, f_c = choisir_alpha(yc, oof_c[cov], bc)
    alpha_a, f_a = choisir_alpha(ya, blend_oof, ba)

    if verbose:
        for nom, y, b, brut, al, f in (("DthCnt", yc, bc, oof_c[cov], alpha_c, f_c),
                                        ("DthAmt", ya, ba, blend_oof, alpha_a, f_a)):
            print(f"\n== {nom} - validation ({validation}) ==")
            ref = rep("ICA brute", y, b)
            rep("ICA recalibree (niveau corrige)", y, b * y.sum() / b.sum(), ref)
            rep("Modele brut", y, brut, ref)
            rep(f"Modele final (alpha={al:.1f}, f={f:.4f})", y, f * shrink(brut, b, al), ref)
            if al == 0:
                print("  -> alpha=0 : le modele n'apporte rien sur les annees recentes ; "
                      "la prediction = ICA recalibree.")

    # ---------- 4) Réentraînement sur TOUT df ----------
    n_c = max(50, int(np.mean(it_c) * 1.1))
    n_a = max(50, int(np.mean(it_a) * 1.1))
    d_full = pd.concat([df, cohort_oof(df, seed=123)], axis=1) if use_coh else df
    yc_f, oc_f = cnt_targets(d_full)
    ya_f, oa_f, wa_f = amt_targets(d_full, w0)
    if verbose:
        print(f"\nReentrainement sur tout df : {n_c} iter (nombre), {n_a} iter (montant), {len(seeds)} graine(s)")
    models_c = [fit_full(d_full[feats], yc_f, oc_f, None, s, n_c, p_cnt).model_to_string() for s in seeds]
    models_a = [fit_full(d_full[feats], ya_f, oa_f, wa_f, s, n_a, params).model_to_string() for s in seeds]

    bundle = dict(mode=mode, feats=feats, models_c=models_c, models_a=models_a,
                  w_blend=w_best, alpha_c=alpha_c, alpha_a=alpha_a, f_c=f_c, f_a=f_a,
                  calib_size={int(k): float(v) for k, v in calib.items()}, coh_k=1.0)
    if use_coh:
        bundle["coh_g"], bundle["coh_k_amt"] = cohort_table(df, bundle["coh_k"])
    if save_path:
        save_bundle(bundle, save_path)
        if verbose:
            print(f"Modele sauvegarde : {save_path}")
    return bundle


# ============================================================================================
# SECTION 8 — EXÉCUTION
# ============================================================================================
def executer(df, resultats, validation="temporal", save_path="modele_mortalite_v2.pkl",
             out_csv="soumission.csv", rapide=False):
    df = verifier_donnees(df, resultats)
    part = pd.to_numeric(resultats["Year"]).isin(pd.to_numeric(df["Year"])).mean()
    mode = "interleaved" if part > 0.9 else "temporal"
    print(f"Part des lignes de resultats dont l'annee existe dans df : {part:.1%} -> mode = {mode}\n")

    kw = dict(params=dict(learning_rate=0.1), seeds=(0,), n_splits=3, max_rounds=500) if rapide else {}
    bundle = run(df, mode=mode, validation=validation, save_path=save_path, **kw)

    sub = predict(bundle, resultats)
    assert len(sub) == len(resultats), "le nombre de lignes a change"
    assert sub[TARGETS].notna().all().all(), "des predictions sont manquantes"
    sub.to_csv(out_csv, index=False)
    print(f"\nSoumission ecrite : {out_csv} ({len(sub):,} lignes)")
    return sub


# ============================================================================================
# SECTION 9 — DIAGNOSTIC sur les vraies valeurs
# ============================================================================================
def diagnostic(sub, verite):
    sub, verite = sub.reset_index(drop=True), verite.reset_index(drop=True)
    assert len(sub) == len(verite), "sub et verite n'ont pas le meme nombre de lignes"

    for cible, base in (("DthCnt", "ExpecCnt"), ("DthAmt", "ExpecAmt")):
        y_all = pd.to_numeric(verite[cible], errors="coerce").to_numpy(float)
        ok = np.isfinite(y_all)
        y, p, b = y_all[ok], sub[cible].to_numpy(float)[ok], verite[base].to_numpy(float)[ok]
        d_mod, d_ica = dev_lignes(y, p), dev_lignes(y, b)

        print(f"\n{'=' * 25} {cible} {'=' * 25}")
        print(f"Deviance MODELE = {d_mod.sum():,.0f} | ICA = {d_ica.sum():,.0f} | "
              f"gain vs ICA = {1 - d_mod.sum() / d_ica.sum():+.2%}")
        print(f"Somme pred / somme reel : modele {p.sum() / y.sum():.4f} | ICA {b.sum() / y.sum():.4f}")

        # Niveau vs forme : on corrige le niveau des deux (avec la vérité, POUR DIAGNOSTIC SEULEMENT)
        d_mod_n = METRIC(y, p * y.sum() / p.sum())
        d_ica_n = METRIC(y, b * y.sum() / b.sum())
        print(f"Niveau corrige (diagnostic) : modele {d_mod_n:,.0f} | ICA {d_ica_n:,.0f} | "
              f"gain {1 - d_mod_n / d_ica_n:+.2%}")
        if d_mod.sum() > d_ica.sum() and d_mod_n < d_ica_n:
            print("  -> Probleme de NIVEAU (tendance / calibration), la forme du modele est bonne.")
        elif d_mod_n >= d_ica_n:
            print("  -> Probleme de FORME (sur-apprentissage ou variables qui ne se transposent pas).")

        t = pd.DataFrame({"y": y, "pred": p, "ica": b, "dev_mod": d_mod, "dev_ica": d_ica,
                          "Size": verite["Size"].values[ok], "Year": verite["Year"].values[ok]})
        print("\nPar Year :")
        g = t.groupby("Year")[["y", "pred", "ica", "dev_mod", "dev_ica"]].sum()
        g["gain"] = 1 - g["dev_mod"] / g["dev_ica"]
        print(g.round(3).to_string())
        print("\nPar Size :")
        g = t.groupby("Size")[["y", "pred", "ica", "dev_mod", "dev_ica"]].sum()
        g["gain"] = 1 - g["dev_mod"] / g["dev_ica"]
        print(g.round(3).to_string())


# ============================================================================================
# SECTION 10 — TEST DE BOUT EN BOUT
# ============================================================================================
def tester(df, resultats_vrais, rapide=False, validation="temporal",
           save_path="modele_mortalite_v2.pkl", out_csv="soumission.csv"):
    verite = resultats_vrais.reset_index(drop=True)
    a_predire = verite.drop(columns=TARGETS, errors="ignore")
    sub = executer(df, a_predire, validation=validation, save_path=save_path,
                   out_csv=out_csv, rapide=rapide)
    diagnostic(sub, verite)
    return sub


