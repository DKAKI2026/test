def comparer_tout(df, resultats, strate, colonnes_modele=None, mode=None, n_plein=N_PLEIN, complement=COMPLEMENT,
                  n_splits=5, rapide=False, seulement_explicable=False, avec_lightgbm_seul=True, avec_glm=True,
                  interactions=None, alphas=None, params=None):
    """
    Tableau unique avec la déviance de Poisson hors-pli de TOUTES les méthodes déjà vues dans ce fichier :
      - table de mortalité seule                     - facteur par strate
      - modèle LightGBM sans facteur / avec facteur   - variantes de GLM (+ GLM + LightGBM)
    seulement_explicable=True : la « meilleure » retenue est choisie parmi facteur par strate et GLM pur seulement
    (une formule ou des tables, sans LightGBM), même si un modèle LightGBM fait mieux.
    Renvoie un dict à passer à entrainer_meilleur_de_tout() (mêmes options que comparer_glm/comparer_modeles).
    """
    mode = mode or detecter_mode(df, resultats)
    if rapide:
        n_splits = 3
    feats = _colonnes_modele(colonnes_modele, mode)
    d_lgb = _preparer_df(df, list(strate) + feats)
    plis = _plis(d_lgb, mode, n_splits)
    y, E = d_lgb["DthAmt"].to_numpy(float), d_lgb["ExpecAmt"].to_numpy(float)
    n = len(d_lgb)
    lignes, oof = [], {}

    print(f"Mode de validation : {mode} ({n_splits} plis) | strate = {list(strate) or '(global)'} | {_pl(n, 'ligne')}\n")

    print("-- Facteur par strate --")
    o = np.full(n, np.nan)
    for tr, va in plis:
        tab, comp = _table(d_lgb.iloc[tr], strate, n_plein, complement)
        o[va] = _appliquer(tab, comp, strate, d_lgb.iloc[va])[0]
    oof["Facteur par strate"] = o
    lignes.append(("Facteur par strate", o, "explicable"))

    p_lgb = dict(PARAMS_MODELE, **(params or {}), **({"learning_rate": 0.15} if rapide else {}))
    mapping = _mapping(d_lgb, feats)
    for avec, nom in ((False, "Modèle LightGBM sans facteur"), (True, "Modèle LightGBM avec facteur")):
        try:
            _lgb()
        except ImportError as e:
            print(f"-- {nom} : ignoré ({e}) --")
            continue
        print(f"-- {nom} --")
        t0 = time.time()
        o = np.full(n, np.nan)
        for tr, va in plis:
            dtr, dva = d_lgb.iloc[tr], d_lgb.iloc[va]
            Ftr = _facteurs_oof(dtr, strate, n_plein, complement) if avec else np.ones(len(dtr))
            tab, comp = _table(dtr, strate, n_plein, complement)
            Fva = _appliquer(tab, comp, strate, dva)[1] if avec else np.ones(len(dva))
            b, best = _fit_lgb(dtr, Ftr, feats, mapping, p_lgb, dva, Fva)
            o[va] = _pred_lgb(b, best, dva, Fva, feats, mapping)
        oof[nom] = o
        lignes.append((nom, o, "boîte noire"))
        print(f"   {time.time() - t0:.0f} s")

    comp_glm = None
    if avec_glm:
        print("\n-- Variantes de GLM --")
        comp_glm = comparer_glm(df, resultats=None, mode=mode, strate=None, n_plein=n_plein, complement=complement,
                                n_splits=n_splits, rapide=rapide, avec_lightgbm=avec_lightgbm_seul, interactions=interactions,
                                alphas=alphas, params=params, seulement_glm=False, afficher=True)
        d_glm = _preparer_glm(df, mode, comp_glm["interactions"])
        for _, r in comp_glm["table"].iterrows():
            if r["Méthode"] in comp_glm["deviances"] and r["Méthode"] not in ("Table de mortalité seule",):
                o = np.full(len(d_glm), np.nan)
                lignes.append((r["Méthode"], None, "explicable" if r["Type"] == "GLM" else "boîte noire"))  # déviance déjà connue

    cov = np.zeros(n, dtype=bool)                                   # lignes couvertes par la validation (mode "futur" : pas toutes)
    for tr, va in plis:
        cov[va] = True
    ref = pdev(y[cov], E[cov])
    table = pd.DataFrame({"Méthode": ["Table de mortalité seule"], "Déviance hors-pli": [ref],
                          "Gain vs table": [0.0], "Type": ["repère"]})
    for nom, o, typ in lignes:
        dv = pdev(y[cov], o[cov]) if o is not None else comp_glm["deviances"][nom]
        table.loc[len(table)] = [nom, dv, 1 - dv / ref, typ]
    table = table.sort_values("Déviance hors-pli").reset_index(drop=True)
    table["Rang"] = table["Déviance hors-pli"].rank(method="min").astype(int)
    candidats = table[table["Type"] != "repère"]
    if seulement_explicable:
        candidats = candidats[candidats["Type"] == "explicable"]
    meilleur = candidats.loc[candidats["Déviance hors-pli"].idxmin(), "Méthode"]
    table["Retenu"] = table["Méthode"] == meilleur

    print("\n== TABLEAU FINAL : déviance de Poisson hors-pli du montant, toutes méthodes (plus petit = mieux) ==")
    print(table[["Rang", "Méthode", "Déviance hors-pli", "Gain vs table", "Type", "Retenu"]].to_string(
        index=False, formatters={"Déviance hors-pli": lambda x: _n(x), "Gain vs table": lambda x: f"{x:.1%}",
                                 "Retenu": lambda x: "<== meilleure" if x else ""}))
    if seulement_explicable and meilleur != table.iloc[0]["Méthode"]:
        print(f"\nNote : « {table.iloc[0]['Méthode']}» fait mieux ({_n(table.iloc[0]['Déviance hors-pli'])}) mais n'est pas explicable "
              f"(formule/tables) -> retenue = « {meilleur} ». seulement_explicable=False pour garder la meilleure quelle qu'elle soit.")

    return dict(table=table, meilleur=meilleur, mode=mode, strate=list(strate), feats=feats, comp_glm=comp_glm,
               n_plein=n_plein, complement=complement, rapide=rapide, params=params)


def entrainer_meilleur_de_tout(df, comparaison, save_path="meilleur_modele_final.pkl"):
    """Entraîne sur tout df la méthode retenue par comparer_tout() et l'enregistre. Renvoie un bundle
    à passer à predire_meilleur() (fonctionne pour les 3 familles : facteur par strate, LightGBM, GLM)."""
    nom, mode = comparaison["meilleur"], comparaison["mode"]
    print(f"== Entraînement final de la méthode retenue : {nom} ==")
    if nom == "Facteur par strate":
        strate, n_plein, comp = comparaison["strate"], comparaison["n_plein"], comparaison["complement"]
        d = _preparer_df(df, strate)
        tab, c = _table(d, strate, n_plein, comp)
        bundle = dict(famille="strate", nom=nom, strate=strate, tab=tab, comp=c)
    elif nom.startswith("Modèle LightGBM"):
        avec = "avec facteur" in nom
        bundle = entrainer_modele(df, comparaison["strate"], colonnes=comparaison["feats"], avec_facteur=avec,
                                  mode=mode, n_plein=comparaison["n_plein"], complement=comparaison["complement"],
                                  rapide=comparaison["rapide"], params=comparaison["params"], save_path=None)
        bundle["famille"] = "lightgbm"
    else:
        bundle = entrainer_meilleur(df, dict(comparaison["comp_glm"], meilleur=nom), save_path=None)
        bundle["famille"] = "glm"
    if save_path:
        with open(save_path, "wb") as f:
            pickle.dump(bundle, f)
        print(f"   modèle enregistré : {save_path}")
    return bundle


def predire_meilleur(bundle, resultats, out_csv="soumission_finale.csv", sep=",", decimal="."):
    """Prédit avec le modèle retenu par comparer_tout()/entrainer_meilleur_de_tout(), quelle que soit sa famille."""
    if bundle["famille"] == "strate":
        return _predire_strate_bundle(bundle, resultats, out_csv, sep, decimal)
    if bundle["famille"] == "lightgbm":
        return predire_avec_modele(bundle, resultats, out_csv, sep, decimal)
    return predire_glm(bundle, resultats, out_csv, sep, decimal)


def _predire_strate_bundle(bundle, resultats, out_csv, sep, decimal):
    strate = bundle["strate"]
    res = preparer_strates(resultats).reset_index(drop=True)
    manque = [c for c in list(strate) + ["ExpecAmt"] if c not in res.columns]
    assert not manque, f"Colonnes manquantes dans resultats : {manque}"
    res["ExpecAmt"] = pd.to_numeric(res["ExpecAmt"], errors="coerce")
    ok = _lignes_ok(res, ["ExpecAmt"] + list(strate))
    assert ok.all(), f"{int((~ok).sum())} lignes de resultats ont une valeur manquante/infinie. Impossible de les predire."
    amt, f, inconnu = _appliquer(bundle["tab"], bundle["comp"], strate, res)
    sub = resultats.copy()
    sub["DthAmt"] = amt
    sub.to_csv(out_csv, index=False, sep=sep, decimal=decimal)
    print(f"{_n(len(sub))} lignes prédites -> {out_csv}")
    if inconnu.any():
        print(f"ATTENTION : {_n(inconnu.sum())} lignes ont une strate absente de df -> facteur de repli utilisé.")
    return sub


def executer_tout(df, resultats, strate, save_path="meilleur_modele_final.pkl", out_csv="soumission_finale.csv", **kw):
    """Tout en un : comparer_tout() + entrainer_meilleur_de_tout() + predire_meilleur(). Renvoie (bundle, sub, table)."""
    comp = comparer_tout(df, resultats, strate, **kw)
    print()
    bundle = entrainer_meilleur_de_tout(df, comp, save_path)
    print()
    sub = predire_meilleur(bundle, resultats, out_csv)
    return bundle, sub, comp["table"]


