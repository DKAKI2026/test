def verifier_3006(n_plein=N_PLEIN):
    """Vérifie d'où vient 3 006, la règle de crédibilité et l'exemple chiffré de la diapo."""
    print("== 1) D'où vient 3 006 ? seuil = (z / marge)^2 ==")
    for p, marge in ((0.90, 0.03), (0.90, 0.05), (0.95, 0.05), (0.95, 0.03)):
        z = NormalDist().inv_cdf((1 + p) / 2)
        print(f"   confiance {p:.0%}, marge +/-{marge:.0%} : z = {z:.4f}  ->  {_n((z / marge) ** 2, 1):>8s} décès")
    z90 = NormalDist().inv_cdf(0.95)
    print(f"   => 3 006 correspond à 90 % de confiance et +/-3 % : ({z90:.4f} / 0.03)^2 = {_n((z90 / 0.03) ** 2, 1)} "
          f"(avec z arrondi à 1.645 : {_n((1.645 / 0.03) ** 2, 1)}, soit 3 007 en arrondissant)")

    print(f"\n== 2) Crédibilité Z = min(1 ; racine(décès / {_n(n_plein)})) ==")
    for d in (10, 50, 100, 300, 480, 1000, 2000, n_plein, 5000):
        print(f"   {_n(d):>6s} décès -> Z = {float(credibilite(d, n_plein)):6.1%}")
    assert float(credibilite(n_plein, n_plein)) == 1.0 and float(credibilite(n_plein * 2, n_plein)) == 1.0
    assert abs(float(credibilite(n_plein / 4, n_plein)) - 0.5) < 1e-12           # quart des décès -> 50 %

    print("\n== 3) Exemple : 480 décès, ratio réel/prévu 0.85 ==")
    z = float(credibilite(480, n_plein))
    f_aucun, f_un = z * 0.85, z * 0.85 + (1 - z) * 1.0
    print(f"   Z = racine(480/{n_plein}) = {z:.4f}")
    print(f"   facteur = Z x ratio                    = {z:.4f} x 0.85                 = {f_aucun:.4f}   (COMPLEMENT = \"aucun\")")
    print(f"   facteur = Z x ratio + (1-Z) x 1.000    = {z:.4f} x 0.85 + {1 - z:.4f} x 1.000 = {f_un:.4f}   (COMPLEMENT = \"un\")")
    assert abs(f_aucun - 0.3397) < 1e-3 and abs(f_un - 0.9401) < 1e-3
    print("   ✓ vérifications réussies")


