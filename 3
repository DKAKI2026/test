# SECTION 1 — Constantes et colonnes dérivées
# ============================================================================================
N_PLEIN = 3006          # décès pour une crédibilité de 100 %
COMPLEMENT = "aucun"    # "aucun" : facteur = Z x ratio | "global" : + (1-Z) x ratio global de df | "un" : + (1-Z) x 1,000

# 10 = T10+T20 et 11 = UL (3,4,5) n'existent que pour 2009-2011 -> groupes cohérents sur toutes les années
GRP_MAP = {1: 1, 2: 2, 3: 3, 4: 3, 5: 3, 11: 3, 6: 6, 7: 6, 10: 6, 8: 8, 9: 9}
DUR_BINS = [1, 2, 3, 4, 5, 6, 11, 16, 21, 26, 10 ** 6]
DUR_LABELS = ["1", "2", "3", "4", "5", "6-10", "11-15", "16-20", "21-25", "26+"]
AGE_BINS = [0, 20, 30, 40, 50, 60, 70, 80, 90, 10 ** 6]
AGE_LABELS = ["0-19", "20-29", "30-39", "40-49", "50-59", "60-69", "70-79", "80-89", "90+"]

COLONNES_DERIVEES = ["Periode", "YearStart", "PolGrp", "DurBand", "AgeBand", "IssueAgeBand"]


def preparer_strates(d):
    """Ajoute les colonnes dérivées : Periode (2009-2010...), PolGrp (types de police regroupés),
    DurBand (tranche de PolYear), AgeBand (tranche d'âge atteint), IssueAgeBand (tranche d'âge à l'émission)."""
    d = d.copy()
    d["YearStart"] = pd.to_numeric(d["Year"]).astype(int) // 100 + 2000        # 910 -> 2009, 2223 -> 2022
    d["Periode"] = d["YearStart"].astype(str) + "-" + (d["YearStart"] + 1).astype(str)
    d["PolGrp"] = d["PolTypeGrp"].map(GRP_MAP).fillna(9).astype(int)
    pol = pd.to_numeric(d["PolYear"]).clip(lower=1)
    if "AttdAge" not in d.columns:
        d["AttdAge"] = d["IssueAge"] + d["PolYear"] - 1
    age = d["AttdAge"]
    d["DurBand"] = pd.cut(pol, DUR_BINS, labels=DUR_LABELS, right=False).astype(str)
    d["AgeBand"] = pd.cut(pd.to_numeric(age).clip(lower=0), AGE_BINS, labels=AGE_LABELS, right=False).astype(str)
    d["IssueAgeBand"] = pd.cut(pd.to_numeric(d["IssueAge"]).clip(lower=0), AGE_BINS, labels=AGE_LABELS, right=False).astype(str)
    return d


def colonnes_strate(df):
    """Liste des colonnes que tu peux mettre dans STRATE."""
    d = preparer_strates(df.head(50))
    exclues = {"DthCnt", "DthAmt", "ExpecCnt", "ExpecAmt", "ExposCnt", "ExposAmt", "ExposAmt2"}
    return [c for c in d.columns if c not in exclues]


def _lignes_ok(d, cols):
    ok = np.ones(len(d), dtype=bool)
    for c in cols:
        s = d[c]
        if pd.api.types.is_numeric_dtype(s):
            ok &= np.isfinite(s.to_numpy(float))
        else:
            ok &= s.notna().to_numpy() & (s.astype(str) != "nan").to_numpy()
    return ok


def _preparer_df(df, strate):
    """df prêt à l'emploi : colonnes dérivées + retrait des lignes inutilisables (valeurs manquantes/infinies)."""
    d = preparer_strates(df)
    manque = [c for c in strate if c not in d.columns]
    assert not manque, f"Colonnes de strate introuvables : {manque}. Colonnes possibles : {colonnes_strate(df)}"
    for c in ("DthCnt", "DthAmt", "ExpecAmt"):
        d[c] = pd.to_numeric(d[c], errors="coerce")
    ok = _lignes_ok(d, ["DthCnt", "DthAmt", "ExpecAmt"] + list(strate))
    if (~ok).any():
        print(f"ATTENTION : {_n((~ok).sum())} lignes de df retirees (valeur manquante/infinie dans les colonnes utilisees).")
    return d.loc[ok].reset_index(drop=True)


def _n(x, nd=0):
    """Nombre formaté avec espaces pour les milliers (ex. 12 345)."""
    return f"{x:,.{nd}f}".replace(",", " ")


def _pl(n, mot):
    """'1 strate' / '2 strates' (accord du pluriel)."""
    return f"{_n(n)} {mot}{'s' if int(n) > 1 else ''}"


def credibilite(deces, n_plein=N_PLEIN):
    """Z = 100 % si décès >= n_plein, sinon racine(décès / n_plein)."""
    return np.minimum(1.0, np.sqrt(np.asarray(deces, float) / n_plein))


def pdev(y, p):
    """Déviance de Poisson moyenne (la métrique du défi). Plus petit = mieux."""
    y, p = np.asarray(y, float), np.clip(np.asarray(p, float), 1e-12, None)
    t = np.where(y > 0, y * np.log(np.where(y > 0, y, 1) / p), 0.0)
    return float(2 * np.sum(t - (y - p)) / len(y))


