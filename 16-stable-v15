# ============================================================================================
# H. Le nombre de plis ameliore-t-il vraiment ? (holdout FIXE, comparaison honnete)
# ============================================================================================
def comparer_nombre_plis(df, resultats, liste_plis=(3, 5, 10), holdout="lignes",
                         part_holdout=0.2, seed=0, **kw_run):
    """
    Holdout FIXE, puis run() avec chaque nombre de plis, deviance comparee sur ce MEME holdout.
      interleaved : holdout="lignes" (cohortes deja vues) ou "cohortes" (cohortes nouvelles)
      temporal    : holdout = la derniere annee de df
    Test rapide : comparer_nombre_plis(df, resultats, seeds=(0,), max_rounds=500,
                                       selection_max_rounds=200)
    """
    df0 = verifier_donnees(df, resultats, verbose=False).reset_index(drop=True)
    part = pd.to_numeric(resultats["Year"]).isin(pd.to_numeric(df0["Year"])).mean()
    mode = "interleaved" if part > 0.9 else "temporal"
    d = prep(df0)
    rng = np.random.default_rng(seed)
    if mode == "temporal":
        ho = (d["YearStart"] == d["YearStart"].max()).values
    elif holdout == "cohortes":
        g = _groupes(d, "cohorte")
        ho = np.isin(g, rng.choice(g.max() + 1, int((g.max() + 1) * part_holdout), replace=False))
    else:
        ho = rng.random(len(d)) < part_holdout
    d_tr, d_ho = df0[~ho], df0[ho]
    y = d_ho[TARGET].values
    dev_ica = dev_lignes(y, d_ho["ExpecAmt"].values).mean()
    print(f"Mode {mode} | holdout : {ho.sum():,} lignes | deviance ICA = {dev_ica:,.2f}\n")

    ancien = PLIS["n_splits"]
    PLIS["n_splits"] = None          # on impose le nombre de plis teste
    lignes = []
    try:
        for k in liste_plis:
            t0 = time.time()
            out = run(d_tr, mode=mode, n_splits=k, verbose=False, **kw_run)
            p = predict(out["bundle"], d_ho)[TARGET].values
            dev = dev_lignes(y, p).mean()
            lignes.append(dict(plis=k, dev_holdout=dev, D2_vs_ICA=1 - dev / dev_ica,
                               balance=p.sum() / y.sum(), minutes=(time.time() - t0) / 60))
            print(f"  {k:>2} plis -> deviance holdout = {dev:,.2f} ({lignes[-1]['minutes']:.1f} min)")
    finally:
        PLIS["n_splits"] = ancien
    t = pd.DataFrame(lignes)
    t["ecart_vs_min_%"] = 100 * (t["dev_holdout"] / t["dev_holdout"].min() - 1)
    print("\n" + t.round(4).to_string(index=False))
    print("\nRegle pratique : un ecart < ~1 % est du bruit -> garde le nombre de plis le moins cher.")
    return t


# ============================================================================================
# I. "Garder le meilleur pli" : test sur holdout fixe
# ============================================================================================
def tester_meilleur_pli(df, resultats, k=10, part_holdout=0.2, seed=0, max_rounds=2000,
                        feats=None, params=None, params_sev=None):
    """
    Entraine k modeles de pli (modele D : frequence x severite), puis compare :
      - score de chaque modele sur SON pli de validation
      - score de chaque modele sur un HOLDOUT FIXE jamais vu
      - score de la MOYENNE des k modeles sur ce holdout
    Si le 'meilleur pli' n'est pas meilleur sur le holdout -> son score etait du bruit.
    """
    params = dict(PARAMS, **(params or {}))
    params_sev = dict(PARAMS_SEV, **(params_sev or {}))
    df0 = verifier_donnees(df, resultats, verbose=False).reset_index(drop=True)
    part = pd.to_numeric(resultats["Year"]).isin(pd.to_numeric(df0["Year"])).mean()
    mode = "interleaved" if part > 0.9 else "temporal"
    d = prep(df0)
    rng = np.random.default_rng(seed)
    if mode == "temporal":
        ho = (d["YearStart"] == d["YearStart"].max()).values
    elif PLIS["groupe"] is not None:
        g = _groupes(d, PLIS["groupe"])
        ho = np.isin(g, rng.choice(g.max() + 1, int((g.max() + 1) * part_holdout), replace=False))
    else:
        ho = rng.random(len(d)) < part_holdout
    d_tr, d_ho = d[~ho].reset_index(drop=True), d[ho].reset_index(drop=True)
    feats = feats or feats_defaut(mode)
    y_ho = d_ho[TARGET].values

    ancien = PLIS["n_splits"]
    PLIS["n_splits"] = k
    try:
        plis = make_folds(d_tr, mode, k)
    finally:
        PLIS["n_splits"] = ancien

    def predire(mf, ms, dd):
        X = dd[feats]
        pc = dd["ExposCnt"].values * np.exp(raw(mf, X) + np.log(dd["qx_cnt"]).values)
        return pc * np.exp(raw(ms, X) + log_sev_ica(dd))

    lignes, preds_ho = [], []
    for j, (tr, va) in enumerate(plis):
        a, b = d_tr.iloc[tr], d_tr.iloc[va]
        yc_a, oc_a, wc_a = cnt_targets(a)
        yc_b, oc_b, wc_b = cnt_targets(b)
        m_a, ys_a, os_a, ws_a = sev_targets(a)
        m_b, ys_b, os_b, ws_b = sev_targets(b)
        mf = fit(a[feats], yc_a, oc_a, wc_a, b[feats], yc_b, oc_b, wc_b, 0, max_rounds, params)
        ms = fit(a[feats][m_a], ys_a[m_a], os_a[m_a], ws_a[m_a],
                 b[feats][m_b], ys_b[m_b], os_b[m_b], ws_b[m_b], 0, max_rounds, params_sev,
                 objective="gamma")
        p_va, p_ho = predire(mf, ms, b), predire(mf, ms, d_ho)
        p_tout = predire(mf, ms, d_tr)          # tout df hors holdout (90 % deja vu)
        preds_ho.append(p_ho)
        lignes.append(dict(pli=j + 1,
                           dev_sur_son_pli=dev_lignes(b[TARGET].values, p_va).mean(),
                           dev_sur_tout_df=dev_lignes(d_tr[TARGET].values, p_tout).mean(),
                           dev_sur_holdout=dev_lignes(y_ho, p_ho).mean()))
        print(f"  pli {j + 1}/{len(plis)} entraine")

    t = pd.DataFrame(lignes)
    t["rang_pli"] = t["dev_sur_son_pli"].rank().astype(int)
    t["rang_tout_df"] = t["dev_sur_tout_df"].rank().astype(int)
    t["rang_holdout"] = t["dev_sur_holdout"].rank().astype(int)
    rho = spearmanr(t["dev_sur_son_pli"], t["dev_sur_holdout"])[0]
    rho_tout = spearmanr(t["dev_sur_tout_df"], t["dev_sur_holdout"])[0]
    meilleur = t.loc[t["dev_sur_son_pli"].idxmin()]
    dev_moy = dev_lignes(y_ho, np.mean(preds_ho, axis=0)).mean()
    dev_ica = dev_lignes(y_ho, d_ho["ExpecAmt"].values).mean()

    print("\n" + t.round(2).to_string(index=False))
    print(f"\nCorrelation (rang) score du pli <-> score holdout : {rho:+.2f}  "
          f"(proche de 0 = le score du pli ne predit rien)")
    print(f"Correlation (rang) score sur tout df <-> score holdout : {rho_tout:+.2f}")
    print(f"Optimisme 'tout df' vs holdout : {t['dev_sur_tout_df'].mean():,.2f} contre "
          f"{t['dev_sur_holdout'].mean():,.2f} "
          f"({100 * (1 - t['dev_sur_tout_df'].mean() / t['dev_sur_holdout'].mean()):.1f} % trop beau)")
    print(f"\nDeviance sur le HOLDOUT :")
    print(f"  ICA                                    : {dev_ica:,.2f}")
    print(f"  'Meilleur pli' (pli {int(meilleur['pli'])}) seul        : {meilleur['dev_sur_holdout']:,.2f}"
          f"   (il affichait {meilleur['dev_sur_son_pli']:,.2f} sur son pli)")
    print(f"  Meilleur modele REEL (vu apres coup)   : {t['dev_sur_holdout'].min():,.2f}")
    print(f"  MOYENNE des {len(plis)} modeles              : {dev_moy:,.2f}")
    return dict(table=t, rho=rho, rho_tout=rho_tout, dev_meilleur_pli=meilleur["dev_sur_holdout"],
                dev_moyenne=dev_moy, dev_ica=dev_ica)   


